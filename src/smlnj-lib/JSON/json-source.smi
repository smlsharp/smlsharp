_require "../../basis.smi"
_require "../../ml-lpt/lib/antlr-stream-pos.smi"
_require "./json.lex.smi"
_require "./json-tokens.smi"

structure JSONSource =
struct
  type state = TextIO.StreamIO.instream * int
  type source = state option ref
  datatype error_code =
      InvalidCharacter
    | InvalidLiteral
    | NumberTooLarge
    | InvalidNumber
    | InvalidArray
    | InvalidObject
    | ExpectedKey
    | ExpectedColon
    | CommentsNotAllowed
    | UnclosedComment
    | UnclosedString
    | InvalidEscape
    | InvalidUTF8
    | IncompleteUTF8
    | InvalidUnicodeSurrogatePair
    | InvalidUnicodeEscape
    | NonPrintingASCII
  val openStream : TextIO.instream -> source
  val openFile : string -> source
  val openString : string -> source
  val close : source -> unit
  val errorMsg : state * error_code -> string
end
