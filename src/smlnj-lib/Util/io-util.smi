_require "../../basis.smi"
_require local "./io-util-sig.sml"

structure IOUtil =
struct
  val withInputFile : string * ('a -> 'b) -> 'a -> 'b
  val withInstream : TextIO.instream * ('a -> 'b) -> 'a -> 'b
  val withOutputFile : string * ('a -> 'b) -> 'a -> 'b
  val withOutstream : TextIO.outstream * ('a -> 'b) -> 'a -> 'b
end
