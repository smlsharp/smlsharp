_require "../../basis.smi"
_require local "./scan-sig.sml"
_require "./atom.smi"
_require "./fmt-fields.smi"

structure Scan =
struct
  datatype fmt_item =
      ATOM of Atom.atom
    | LINT of LargeInt.int
    | INT of Int.int
    | LWORD of LargeWord.word
    | WORD of Word.word
    | WORD8 of Word8.word
    | BOOL of bool
    | CHR of char
    | STR of string
    | REAL of Real.real
    | LREAL of LargeReal.real
    | LEFT of int * fmt_item
    | RIGHT of int * fmt_item
  exception BadFormat = FmtFields.BadFormat
  val sscanf : string -> string -> fmt_item list option
  val scanf : string -> (char, 'a) StringCvt.reader
              -> (fmt_item list, 'a) StringCvt.reader
end
