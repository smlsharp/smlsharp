(* -*- sml -*- *)
(**
 * FFI attributes
 *
 * @copyright (C) 2021 SML# Development Team.
 * @author UENO Katsuhiro
 *)
structure FFIAttributes =
struct

  fun iftrue (x, y) true = x
    | iftrue (x, y) false = y

  (*% *)
  datatype callingConvention =
      (*% @format "cdecl" *) FFI_CDECL
    | (*% @format "stdcall" *) FFI_STDCALL
    | (*% @format "fastcc" *) FFI_FASTCC

  (*%
   * @formatter(iftrue) iftrue
   *)
  type attributes =
      (*%
       * @format({isPure, fast, unsafe, causeGC, callingConvention: cc ccopt})
       * "__attr__(("
       * isPure:iftrue()("pure,",)
       * fast:iftrue()("fast,",)
       * unsafe:iftrue()("unsafe,",)
       * causeGC:iftrue()("gc,",)
       * ccopt(cc)
       * "))"
       *)
      {
        isPure: bool,
        fast: bool,
        unsafe: bool,
        causeGC: bool,
        callingConvention: callingConvention option
      }

  val defaultFFIAttributes =
      {
        isPure = false,
        fast = false,
        unsafe = false,
        causeGC = false,
        callingConvention = NONE
      }

  (*% *)
  datatype globalSymbolKind =
      ForeignCodeSymbol

end
