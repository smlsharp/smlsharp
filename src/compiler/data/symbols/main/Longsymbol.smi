_require "../../../../basis.smi"
_require "../../../../smlformat-lib.smi"
_require "../../../../smlnj-lib/Util/binary-set-fn.smi"
_require "../../../../smlnj-lib/Util/binary-map-fn.smi"
_require "./Symbol.smi"

structure Longsymbol =
struct
  eqtype longsymbol (= *)
  val format_longsymbol : longsymbol -> SMLFormat.format

  val toStringList : longsymbol -> string list * string
  val fromStringList : string list * string -> longsymbol
  val toSymbolList : longsymbol -> Symbol.symbol list * Symbol.symbol
  val fromSymbolList : Symbol.symbol list * Symbol.symbol -> longsymbol
  val toString : longsymbol -> string
  val compare : longsymbol * longsymbol -> order
  val last : longsymbol -> Symbol.symbol

  structure Ord =
  struct
    type ord_key = longsymbol
    val compare : ord_key * ord_key -> order
  end
  structure Map = BinaryMapFn(Ord)
  structure Set = BinarySetFn(Ord)
end
