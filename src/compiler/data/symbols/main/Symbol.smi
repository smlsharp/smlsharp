_require "../../../../basis.smi"
_require "../../../../smlformat-lib.smi"
_require "../../../../smlnj-lib/Util/binary-set-fn.smi"
_require "../../../../smlnj-lib/Util/binary-map-fn.smi"

structure Symbol =
struct
  eqtype symbol (= string)
  val format_symbol : symbol -> SMLFormat.format

  val toString : symbol -> string
  val fromString : string -> symbol
  val compare : symbol * symbol -> order

  structure Ord =
  struct
    type ord_key = symbol
    val compare : ord_key * ord_key -> order
  end
  structure Map = BinaryMapFn(Ord)
  structure Set = BinarySetFn(Ord)
end

structure Longsymbol =
struct
  eqtype longsymbol (= list)
  val format_longsymbol : longsymbol -> SMLFormat.format

  val toStringList : longsymbol -> string list
  val fromStringList : string list -> longsymbol
  val toSymbolList : longsymbol -> Symbol.symbol list
  val fromSymbolList : Symbol.symbol list -> longsymbol
  val toString : longsymbol -> string
  val compare : longsymbol * longsymbol -> order
  val append : longsymbol * Symbol.symbol -> longsymbol
  val lastSymbol : longsymbol -> Symbol.symbol

  structure Ord =
  struct
    type ord_key = longsymbol
    val compare : ord_key * ord_key -> order
  end
  structure Map = BinaryMapFn(Ord)
  structure Set = BinarySetFn(Ord)
end
