_require "../../../../basis.smi"
_require "../../../../smlformat-lib.smi"
_require "../../../../smlnj-lib/Util/binary-set-fn.smi"
_require "../../../../smlnj-lib/Util2/binary-map-fn2.smi"
_require "./Loc.smi"

structure Symbol =
struct
  eqtype symbol (= string)
  type longsymbol = symbol list
  val format_symbol : symbol -> SMLFormat.format
  val format_longsymbol : longsymbol -> SMLFormat.format

  val toString : symbol -> string
  val fromString : string -> symbol
  val compare : symbol * symbol -> order

  val toStringList : longsymbol -> string list
  val fromStringList : string list -> longsymbol
  val longsymbolToString : longsymbol -> string
  val compareLongsymbol : longsymbol * longsymbol -> order
end

structure SymbolOrd =
struct
  type ord_key = Symbol.symbol
  val compare : ord_key * ord_key -> order
end
structure SymbolEnv = BinaryMapFn2(SymbolOrd)
structure SymbolSet = BinarySetFn(SymbolOrd)

structure LongsymbolOrd =
struct
  type ord_key = Symbol.longsymbol
  val compare : ord_key * ord_key -> order
end
structure LongsymbolEnv = BinaryMapFn2(LongsymbolOrd)
structure LongsymbolSet = BinarySetFn(LongsymbolOrd)
