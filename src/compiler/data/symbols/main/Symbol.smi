_require "../../../../basis.smi"
_require "../../../../smlformat-lib.smi"
_require "../../../../smlnj-lib/Util/binary-set-fn.smi"
_require "../../../../smlnj-lib/Util/binary-map-fn.smi"

structure Symbol =
struct
  eqtype symbol (= *)
  val format_symbol : symbol -> SMLFormat.format

  val toString : symbol -> string
  val intern : string -> symbol
  val compare : symbol * symbol -> order
  val generate : symbol option -> symbol

  structure Ord =
  struct
    type ord_key = symbol
    val compare : ord_key * ord_key -> order
  end
  structure Map = BinaryMapFn(Ord)
  structure Set = BinarySetFn(Ord)
end
