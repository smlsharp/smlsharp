  val format_valdesc : SMLFormat.format -> Absyn.valdesc -> SMLFormat.format
  val format_typdesc : SMLFormat.format -> Absyn.typdesc -> SMLFormat.format
  val format_condesc : Absyn.condesc -> SMLFormat.format
  val format_datdesc : SMLFormat.format -> Absyn.datdesc -> SMLFormat.format
  val format_exdesc : SMLFormat.format -> Absyn.exdesc -> SMLFormat.format
  val format_wheretype : SMLFormat.format -> Absyn.wheretype -> SMLFormat.format
  val format_spec : Absyn.spec -> SMLFormat.format
  val format_sigexp : Absyn.sigexp -> SMLFormat.format
  val format_strdesc : SMLFormat.format -> Absyn.strdesc -> SMLFormat.format
