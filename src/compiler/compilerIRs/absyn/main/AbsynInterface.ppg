(* -*- sml -*- *)
(**
 * syntax for the interface.
 *
 * @copyright (C) 2021 SML# Development Team.
 * @author UENO Katsuhiro
 * @author Atsushi Ohori
 * @author Liu Bochao
 *)
structure AbsynInterface =
struct

  type loc = Absyn.loc

  (*% @formatter(AbsynTy.id) AbsynTyFormatter.format_id *)
  type id = AbsynTy.id

  (*% @formatter(Absyn.vid) AbsynTyFormatter.format_vid *)
  type vid = Absyn.vid

  (*% @formatter(Absyn.longvid) AbsynTyFormatter.format_longvid *)
  type longvid = Absyn.longvid

  (*% @formatter(Absyn.tycon) AbsynTyFormatter.format_tycon *)
  type tycon = Absyn.tycon

  (*% @formatter(Absyn.longtycon) AbsynTyFormatter.format_longtycon *)
  type longtycon = Absyn.longtycon

  (*% @formatter(Absyn.tyvar) AbsynTyFormatter.format_tyvar *)
  type tyvar = Absyn.tyvar

  (*% @formatter(Absyn.tyvarseq) AbsynTyFormatter.format_tyvarseq *)
  type tyvarseq = Absyn.tyvarseq

  (*%
   * @formatter(Absyn.kinded_tyvarseq)
   * AbsynTyFormatter.format_kinded_tyvarseq
   *)
  type kinded_tyvarseq = Absyn.kinded_tyvarseq

  (*% @formatter(Absyn.ty) AbsynTyFormatter.format_ty *)
  type ty = Absyn.ty

  (*% @formatter(Absyn.strid) AbsynFormatter.format_strid *)
  type strid = Absyn.strid

  (*% @formatter(Absyn.sigid) AbsynFormatter.format_sigid *)
  type sigid = Absyn.sigid

  (*% @formatter(Absyn.funid) AbsynFormatter.format_funid *)
  type funid = Absyn.funid

  (*% @formatter(Absyn.longstrid) AbsynFormatter.format_longstrid *)
  type longstrid = Absyn.longstrid

  (*% @formatter(Absyn.require_path) AbsynFormatter.format_require_path *)
  type require_path = Absyn.require_path

  (*% @formatter(Absyn.exbind) AbsynFormatter.format_exbind *)
  datatype exbind = datatype Absyn.exbind

  (*% @formatter(Absyn.fun_param) AbsynFormatter.format_fun_param *)
  datatype fun_param = datatype Absyn.fun_param

  (*% *)
  datatype opaque_impl =
      (*% @format(ty) ty *)
      IMPL_TY of longtycon
    | (*% @format "*" *)
      IMPL_TUPLE of loc
    | (*% @format "{}" *)
      IMPL_RECORD of loc
    | (*% @format "->" *)
      IMPL_FUNC of loc

  (*% *)
  datatype overload_instance =
      (*%
       * @format(exp)
       * exp
       *)
      INST_OVERLOAD of overload_case
    | (*%
       * @format(vid)
       * vid
       *)
      INST_LONGVID of longvid
    | (*%
       * @format(exp * loc)
       * "(" !N0{ exp } ")"
       *)
      INST_PAREN of overload_instance * loc

  withtype overload_mrule =
      (*%
       * @format(ty * inst * loc)
       * !N0{ ty +d "=>" +1 inst }
       *)
      ty * overload_instance * loc

  and overload_case =
      (*%
       * @format(tyvar * ty * mrule mrules * loc)
       * R2{
       *   !N0{ "case" 2[+1] !N0{ tyvar +1 "in" +d ty } +1 "of" }
       *   2[+1]
       *   mrules(mrule:overload_mrule)(+1 "|" +d)
       * }
       *)
      tyvar * ty * (ty * overload_instance * loc) list * loc

  (*% @params(head) *)
  datatype valbind =
      (*%
       * @format(vid * ty * loc)
       * !N0{ head vid +1 ":" +d ty }
       *)
      VAL_EXTERN of vid * ty * loc
    | (*%
       * @format(vid * longvid * loc)
       * !N0{ head vid +1 "=" +d longvid }
       *)
      VAL_ALIAS of vid * longvid * loc
    | (*%
       * @format(vid * name * ty * loc)
       * !N0{
       *   head
       *   vid
       *   +1 "=" +d
       *   !N0{ "_builtin" +d "val" +d name +1 ":" +d ty }
       * }
       *)
      VAL_BUILTIN of vid * vid * ty * loc
    | (*%
       * @format(vid * overload * loc)
       * !N0{ head vid +1 "=" +d overload }
       *)
      VAL_OVERLOAD of vid * overload_case * loc

  (*%
   * @params(head)
   * @formatter(ifsome) AbsynFormatterUtils.ifsome
   *)
  type typdesc =
      (*%
       * @format(tyvarseq tyvarseqOpt * tycon * impl * loc)
       * !N0{
       *   head
       *   tyvarseqOpt(tyvarseq) tyvarseqOpt:ifsome()(+1,) tycon
       *   +1
       *   "(" !N0{ "=" +d impl } ")"
       * }
       *)
      tyvarseq option * tycon * opaque_impl * loc

  (*%
   * @params(head)
   * @formatter(Absyn.typbind) AbsynFormatter.format_typbind
   *)
  datatype typbind =
      (*%
       * @format(typbind)
       * typbind(head)
       *)
      TYPBIND of Absyn.typbind
    | (*%
       * @format(typdesc)
       * typdesc(head)
       *)
      TYPDESC of typdesc

  (*%
   * @formatter(Absyn.datbind) AbsynFormatter.format_datbind
   * @formatter(Absyn.withty) AbsynFormatter.format_withty
   * @formatter(decs) AbsynFormatterUtils.decs
   * @formatter(ifcons) AbsynFormatterUtils.ifcons
   * @formatter(ifsome) AbsynFormatterUtils.ifsome
   *)
  datatype dec =
      (*%
       * @format(tyvarseq tyvarseqOpt * valbind * loc)
       * !N0{
       *   valbind()(
       *     "val" +d
       *     tyvarseqOpt(tyvarseq)
       *     tyvarseqOpt:ifsome()(+d,)
       *   )
       * }
       *)
      DECVAL of kinded_tyvarseq option * valbind * loc
    | (*%
       * @format(typbind typbinds * loc)
       * !N0{ "ty" typbinds:decs(typbind)("pe" +d, +1 "an", "d" +d) }
       *)
      DECTYPE of typbind list * loc
    | (*%
       * @format(typdesc typdescs * loc)
       * !N0{ "eq" typdescs:decs(typdesc)("type" +d, +1 "an", "d" +d) }
       *)
      DECEQTYPE of typdesc list * loc
    | (*%
       * @format(datbind datbinds * withty withtyOpt * loc)
       * !N0{
       *   datbinds:decs(datbind)("datatype" +d, +1, "and" +d)
       *   withtyOpt:ifsome()(+1,)
       *   withtyOpt(withty)
       * }
       *)
      DECDATATYPE of Absyn.datbind list * Absyn.withty option * loc
    | (*%
       * @format(tycon * longtycon * loc)
       * !N0{ "datatype" +d tycon +d "=" +1 "datatype" +d longtycon }
       *)
      DECDATATYPEREP of tycon * longtycon * loc
    | (*%
       * @format(tycon * name * loc)
       * !N0{ "datatype" +d tycon +d "=" +1 "_builtin" +d "datatype" +d name }
       *)
      DECTYPEBUILTIN of tycon * tycon * loc
    | (*%
       * @format(exbind exbinds * loc)
       * !N0{ "ex" exbinds:decs(exbind)("ception" +d, +1 "an", "d" +d) }
       *)
      DECEXCEPTION of exbind list * loc
    | (*%
       * @format(strbind * loc)
       * !N0{ strbind()("structure" +d) }
       *)
      DECSTRUCTURE of strbind * loc
    | (*%
       * @format(loc)
       * ";"
       *)
      DECSEMICOLON of loc

  and strexp =
      (*%
       * @format(dec decs * loc)
       * !N0{
       *   "struct"
       *   decs:ifcons()(2[+1],)
       *   decs(dec)(2[+1])
       *   +1 "end"
       * }
       *)
      STRBASIC of dec list * loc
    | (*%
       * @format(longstrid)
       * longstrid
       *)
      STRID of longstrid
    | (*%
       * @format(funid * longstrid * loc)
       * !N0{ funid "(" 2[1] longstrid 1 ")" }
       *)
      STRAPP of funid * longstrid * loc

  withtype (*% @params(head) *) strbind =
      (*%
       * @format(strid * strexp * loc)
       * !N0{ head strid +d "=" +1 strexp }
       *)
      strid * strexp * loc

  (*% @params(head) *)
  type funbind =
      (*%
       * @format(funid * param paramOpt * strexp * loc)
       * !N0{
       *   head
       *   funid
       *   "(" 2[1] paramOpt(param) 1 ")"
       *   +d "=" +1
       *   strexp
       * }
       *)
      funid * fun_param option * strexp * loc

  (*%
   * @formatter(ifsome) AbsynFormatterUtils.ifsome
   * @formatter(ifcons) AbsynFormatterUtils.ifcons
  *)
  datatype topdec =
      (*%
       * @format(dec)
       * dec
       *)
      TOPDEC of dec
    | (*%
       * @format(funbind * loc)
       * !N0{ funbind()("functor" +d) }
       *)
      TOPFUNCTOR of funbind * loc
    | (*%
       * @format(prec precOpt * vid vids * loc)
       * !N0{
       *   "infix"
       *   precOpt:ifsome()(+d precOpt(prec),)
       *   vids:ifcons()(2[+1],)
       *   !N0{ vids(vid)(+1) }
       * }
       *)
      TOPINFIX of string option * vid list * loc
    | (*%
       * @format(prec precOpt * vid vids * loc)
       * !N0{
       *   "infixr"
       *   precOpt:ifsome()(+d precOpt(prec),)
       *   vids:ifcons()(2[+1],)
       *   !N0{ vids(vid)(+1) }
       * }
       *)
      TOPINFIXR of string option * vid list * loc
    | (*%
       * @format(vid vids * loc)
       * !N0{
       *   "nonfix"
       *   vids:ifcons()(2[+1],)
       *   !N0{ vids(vid)(+1) }
       * }
       *)
      TOPNONFIX of vid list * loc

  (*%
   * @formatter(ifcons) AbsynFormatterUtils.ifcons
   *)
  datatype require =
      (*%
       * @format(path * prop props * loc)
       * !N0{ "_require" +1 path !N0{ props:ifcons()(+1,) props(prop)(+1) } }
       *)
      REQUIRE of require_path * id list * loc
    | (*%
       * @format(path * prop props * loc)
       * !N0{
       *   "_require" +d "local" +1 path
       *   !N0{ props:ifcons()(+1,) props(prop)(+1) }
       * }
       *)
      REQUIRE_LOCAL of require_path * id list * loc
    | (*%
       * @format(path * loc)
       * !N0{ "_use" +d "local" +1 path }
       *)
      USE_LOCAL of require_path * loc
    | (*%
       * @format
       * ";"
       *)
      REQSEMICOLON of loc

  (*% *)
  datatype include_dec =
      (*%
       * @format(path * loc)
       * !N0{ "include" +1 path }
       *)
      INCLUDE of require_path * loc
    | (*%
       * @format
       * ";"
       *)
      INCSEMICOLON of loc

  (*%
   * @formatter(Absyn.sigbind) AbsynFormatter.format_sigbind
   * @formatter(decs) AbsynFormatterUtils.decs
   *)
  datatype sigdec =
      (*%
       * @format(sigbind sigbinds * loc)
       * !N0{ sigbinds:decs(sigbind)("signature" +d, +1, "and" +d) }
       *)
      SIGNATURE of Absyn.sigbind list * loc
    | (*%
       * @format(loc)
       * ";"
       *)
      SIGSEMICOLON of loc

  (*%
   * @formatter(ifcons) AbsynFormatterUtils.ifcons
   *)
  datatype top =
      (*%
       * @format(require requires * topdec topdecs * loc)
       * requires(require)(\n)
       * topdecs:ifcons()(\n,)
       * topdecs(topdec)(\n)
       *)
      INTERFACE of require list * topdec list * loc
    | (*%
       * @format(inc incs * sigdec sigdecs * loc)
       * incs(inc)(\n)
       * sigdecs:ifcons()(\n,)
       * sigdecs(sigdec)(\n)
       *)
      INCLUDES of include_dec list * sigdec list * loc

end
