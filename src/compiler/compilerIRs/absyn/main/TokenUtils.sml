structure TokenUtils =
struct
  structure T = Token

  fun tokenName token =
      case token of
      T.EOF => "EOF"
    | T.COMMENT => "COMMENT"
    | T.ABSTYPE => "ABSTYPE"
    | T.AND => "AND"
    | T.ANDALSO => "ANDALSO"
    | T.AS => "AS"
    | T.CASE => "CASE"
    | T.DATATYPE => "DATATYPE"
    | T.DO => "DO"
    | T.ELSE => "ELSE"
    | T.END => "END"
    | T.EXCEPTION => "EXCEPTION"
    | T.FN => "FN"
    | T.FUN => "FUN"
    | T.HANDLE => "HANDLE"
    | T.IF => "IF"
    | T.IN => "IN"
    | T.INFIX => "INFIX"
    | T.INFIXR => "INFIXR"
    | T.LET => "LET"
    | T.LOCAL => "LOCAL"
    | T.NONFIX => "NONFIX"
    | T.OF => "OF"
    | T.OP => "OP"
    | T.OPEN => "OPEN"
    | T.ORELSE => "ORELSE"
    | T.RAISE => "RAISE"
    | T.REC => "REC"
    | T.THEN => "THEN"
    | T.TYPE => "TYPE"
    | T.VAL => "VAL"
    | T.WITH => "WITH"
    | T.WITHTYPE => "WITHTYPE"
    | T.WHILE => "WHILE"
    | T.LPAREN => "LPAREN"
    | T.RPAREN => "RPAREN"
    | T.LBRACKET => "LBRACKET"
    | T.RBRACKET => "RBRACKET"
    | T.LBRACE => "LBRACE"
    | T.RBRACE => "RBRACE"
    | T.COMMA => "COMMA"
    | T.COLON => "COLON"
    | T.SEMICOLON => "SEMICOLON"
    | T.PERIODS => "PERIODS"
    | T.UNDERBAR => "UNDERBAR"
    | T.BAR => "BAR"
    | T.EQ => "EQ"
    | T.DARROW => "DARROW"
    | T.ARROW => "ARROW"
    | T.HASH => "HASH"
    | T.EQTYPE => "EQTYPE"
    | T.FUNCTOR => "FUNCTOR"
    | T.INCLUDE => "INCLUDE"
    | T.SHARING => "SHARING"
    | T.SIG => "SIG"
    | T.SIGNATURE => "SIGNATURE"
    | T.STRUCT => "STRUCT"
    | T.STRUCTURE => "STRUCTURE"
    | T.WHERE => "WHERE"
    | T.OPAQUE => "OPAQUE"
    | T.ASTERISK => "ASTERISK"
    | T.PERIOD => "PERIOD"
    | T.U_ATTRIBUTE => "U_ATTRIBUTE"
    | T.U_BUILTIN => "U_BUILTIN"
    | T.U_FOREACH => "U_FOREACH"
    | T.U_IMPORT => "U_IMPORT"
    | T.U_INTERFACE => "U_INTERFACE"
    | T.U_JOIN => "U_JOIN"
    | T.U_EXTEND => "U_EXTEND"
    | T.U_UPDATE => "U_UPDATE"
    | T.U_DYNAMIC => "U_DYNAMIC"
    | T.U_DYNAMICCASE => "U_DYNAMICCASE"
    | T.U_DYNAMICNULL => "U_DYNAMICNULL"
    | T.U_DYNAMICVIEW => "U_DYNAMICVIEW"
    | T.U_DYNAMICVOID => "U_DYNAMICVOID"
    | T.U_REIFYTY => "U_REIFYTY"
    | T.U_REQUIRE => "U_REQUIRE"
    | T.U_SIZEOF => "U_SIZEOF"
    | T.U_SQL => "U_SQL"
    | T.U_SQLEVAL => "U_SQLEVAL"
    | T.U_SQLEXEC => "U_SQLEXEC"
    | T.U_SQLSERVER => "U_SQLSERVER"
    | T.U_USE => "U_USE"
    | T.ALNUMID _ => "ALNUMID"
    | T.EQTYVAR _ => "EQTYVAR"
    | T.FREE_TYVAR _ => "FREE_TYVAR"
    | T.FREE_EQTYVAR _ => "FREE_EQTYVAR"
    | T.SYMBOLID _ => "SYMBOLID"
    | T.TYVAR _ => "TYVAR"
    | T.CHAR _ => "CHAR"
    | T.HASH_STRING _ => "HASH_STRING"
    | T.INT _ => "INT"
    | T.INTX _ => "INTX"
    | T.INTLAB _ => "INTLAB"
    | T.REAL _ => "REAL"
    | T.STRING _ => "STRING"
    | T.WORD _ => "WORD"
    | T.WORDX _ => "WORDX"

fun toString token =
    case token of
      T.EOF => ""
    | T.COMMENT => ""
    | T.ABSTYPE => "abstype"
    | T.AND => "and"
    | T.ANDALSO => "andalso"
    | T.AS => "as"
    | T.CASE => "case"
    | T.DATATYPE => "datatype"
    | T.DO => "do"
    | T.ELSE => "else"
    | T.END => "end"
    | T.EXCEPTION => "exception"
    | T.FN => "fn"
    | T.FUN => "fun"
    | T.HANDLE => "handle"
    | T.IF => "if"
    | T.IN => "in"
    | T.INFIX => "infix"
    | T.INFIXR => "infixr"
    | T.LET => "let"
    | T.LOCAL => "local"
    | T.NONFIX => "nonfix"
    | T.OF => "of"
    | T.OP => "op"
    | T.OPEN => "open"
    | T.ORELSE => "orelse"
    | T.RAISE => "raise"
    | T.REC => "rec"
    | T.THEN => "then"
    | T.TYPE => "type"
    | T.VAL => "val"
    | T.WITH => "with"
    | T.WITHTYPE => "withtype"
    | T.WHILE => "while"
    | T.LPAREN => "("
    | T.RPAREN => ")"
    | T.LBRACKET => "["
    | T.RBRACKET => "]"
    | T.LBRACE => "{"
    | T.RBRACE => "}"
    | T.COMMA => ","
    | T.COLON => ":"
    | T.SEMICOLON => ";"
    | T.PERIODS => "..."
    | T.UNDERBAR => "_"
    | T.BAR => "|"
    | T.EQ => "="
    | T.DARROW => "=>"
    | T.ARROW => "->"
    | T.HASH => "#"
    | T.EQTYPE => "eqtype"
    | T.FUNCTOR => "functor"
    | T.INCLUDE => "include"
    | T.SHARING => "sharing"
    | T.SIG => "sig"
    | T.SIGNATURE => "signature"
    | T.STRUCT => "struct"
    | T.STRUCTURE => "structure"
    | T.WHERE => "where"
    | T.OPAQUE => "opaque"
    | T.ASTERISK => "*"
    | T.PERIOD => "."
    | T.U_ATTRIBUTE => "_attribute"
    | T.U_BUILTIN => "_builtin"
    | T.U_FOREACH => "_foreach"
    | T.U_IMPORT => "_import"
    | T.U_INTERFACE => "_interface"
    | T.U_JOIN => "_join"
    | T.U_EXTEND => "_extend"
    | T.U_UPDATE => "_update"
    | T.U_DYNAMIC => "_dynamic"
    | T.U_DYNAMICCASE => "_dynamiccase"
    | T.U_DYNAMICNULL => "_dynamicnull"
    | T.U_DYNAMICVIEW => "_dynamicview"
    | T.U_DYNAMICVOID => "_dynamicvoid"
    | T.U_REIFYTY => "_reifyTy"
    | T.U_REQUIRE => "_require"
    | T.U_SIZEOF => "_sizeof"
    | T.U_SQL => "_sql"
    | T.U_SQLEVAL => "_sqleval"
    | T.U_SQLEXEC => "_sqlexec"
    | T.U_SQLSERVER => "_sqlserver"
    | T.U_USE => "_use"
    | T.ALNUMID s => s
    | T.EQTYVAR s => s
    | T.FREE_TYVAR s => s
    | T.FREE_EQTYVAR s => s
    | T.SYMBOLID s => s
    | T.TYVAR s => s
    | T.CHAR s => "#\"" ^ String.toString s ^ "\""
    | T.HASH_STRING s => "#\"" ^ String.toString s ^ "\""
    | T.INT s => s
    | T.INTX s => s
    | T.INTLAB s => s
    | T.REAL s => s
    | T.STRING s => "\"" ^ String.toString s ^ "\""
    | T.WORD s => s
    | T.WORDX s => s

end
