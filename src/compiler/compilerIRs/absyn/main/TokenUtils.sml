structure TokenUtils =
struct
  structure T = Token

  fun tokenName token =
      case token of
      T.EOF => "EOF"
    | T.COMMENT => "COMMENT"
    | T.INVALID _ => "INVALID"
    | T.ABSTYPE => "ABSTYPE"
    | T.AND => "AND"
    | T.ANDALSO => "ANDALSO"
    | T.AS => "AS"
    | T.CASE => "CASE"
    | T.DATATYPE => "DATATYPE"
    | T.DO => "DO"
    | T.ELSE => "ELSE"
    | T.END => "END"
    | T.EXCEPTION => "EXCEPTION"
    | T.FN => "FN"
    | T.FUN => "FUN"
    | T.HANDLE => "HANDLE"
    | T.IF => "IF"
    | T.IN => "IN"
    | T.INFIX => "INFIX"
    | T.INFIXR => "INFIXR"
    | T.LET => "LET"
    | T.LOCAL => "LOCAL"
    | T.NONFIX => "NONFIX"
    | T.OF => "OF"
    | T.OP => "OP"
    | T.OPEN => "OPEN"
    | T.ORELSE => "ORELSE"
    | T.RAISE => "RAISE"
    | T.REC => "REC"
    | T.THEN => "THEN"
    | T.TYPE => "TYPE"
    | T.VAL => "VAL"
    | T.WITH => "WITH"
    | T.WITHTYPE => "WITHTYPE"
    | T.WHILE => "WHILE"
    | T.LPAREN => "LPAREN"
    | T.RPAREN => "RPAREN"
    | T.LBRACKET => "LBRACKET"
    | T.RBRACKET => "RBRACKET"
    | T.LBRACE => "LBRACE"
    | T.RBRACE => "RBRACE"
    | T.COMMA => "COMMA"
    | T.COLON => "COLON"
    | T.SEMICOLON => "SEMICOLON"
    | T.PERIODS => "PERIODS"
    | T.UNDERBAR => "UNDERBAR"
    | T.BAR => "BAR"
    | T.EQ => "EQ"
    | T.DARROW => "DARROW"
    | T.ARROW => "ARROW"
    | T.HASH => "HASH"
    | T.EQTYPE => "EQTYPE"
    | T.FUNCTOR => "FUNCTOR"
    | T.INCLUDE => "INCLUDE"
    | T.SHARING => "SHARING"
    | T.SIG => "SIG"
    | T.SIGNATURE => "SIGNATURE"
    | T.STRUCT => "STRUCT"
    | T.STRUCTURE => "STRUCTURE"
    | T.WHERE => "WHERE"
    | T.OPAQUE => "OPAQUE"
    | T.ASTERISK => "ASTERISK"
    | T.PERIOD => "PERIOD"
    | T.U_ATTRIBUTE => "U_ATTRIBUTE"
    | T.U_BUILTIN => "U_BUILTIN"
    | T.U_FOREACH => "U_FOREACH"
    | T.U_IMPORT => "U_IMPORT"
    | T.U_INTERFACE => "U_INTERFACE"
    | T.U_JOIN => "U_JOIN"
    | T.U_EXTEND => "U_EXTEND"
    | T.U_UPDATE => "U_UPDATE"
    | T.U_DYNAMIC => "U_DYNAMIC"
    | T.U_DYNAMICCASE => "U_DYNAMICCASE"
    | T.U_DYNAMICNULL => "U_DYNAMICNULL"
    | T.U_DYNAMICVIEW => "U_DYNAMICVIEW"
    | T.U_DYNAMICVOID => "U_DYNAMICVOID"
    | T.U_POLYREC => "U_POLYREC"
    | T.U_REIFYTY => "U_REIFYTY"
    | T.U_REQUIRE => "U_REQUIRE"
    | T.U_SIZEOF => "U_SIZEOF"
    | T.U_SQL => "U_SQL"
    | T.U_SQLEVAL => "U_SQLEVAL"
    | T.U_SQLEXEC => "U_SQLEXEC"
    | T.U_SQLSERVER => "U_SQLSERVER"
    | T.U_USE => "U_USE"
    | T.ALNUMID _ => "ALNUMID"
    | T.EQTYVAR _ => "EQTYVAR"
    | T.FREE_TYVAR _ => "FREE_TYVAR"
    | T.FREE_EQTYVAR _ => "FREE_EQTYVAR"
    | T.PREFIXEDLABEL _ => "PREFIXEDLABEL"
    | T.SYMBOLID _ => "SYMBOLID"
    | T.TYVAR _ => "TYVAR"
    | T.CHAR _ => "CHAR"
    | T.HASH_STRING _ => "HASH_STRING"
    | T.INT _ => "INT"
    | T.INTX _ => "INTX"
    | T.INTLAB _ => "INTLAB"
    | T.REAL _ => "REAL"
    | T.STRING _ => "STRING"
    | T.WORD _ => "WORD"
    | T.WORDX _ => "WORDX"

end
