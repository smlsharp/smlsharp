(* -*- sml -*- *)
(**
 * syntax for the interface.
 *
 * @copyright (C) 2021 SML# Development Team.
 * @author UENO Katsuhiro
 * @author Atsushi Ohori
 * @author Liu Bochao
 *)
structure AbsynInterfaceLoaded =
struct

  type loc = Absyn.loc

  (*%
   * @formatter(ifcons) AbsynFormatterUtils.ifcons
   * @formatter(InterfaceID.id) InterfaceID.format_id
   * @formatter(InterfaceName.interface_name)
   * InterfaceName.format_interface_name
   * @formatter(AbsynInterface.topdec) AbsynInterface.format_topdec
   *)
  type interface_dec =
      (*%
       * @format({interfaceId, interfaceName, requiredIds: req reqs,
       *          provideTopdecs: dec decs})
       * !N0{
       *   "_interface" +d interfaceId
       *   2[+1] "as" +d !N0{ interfaceName }
       *   reqs:ifcons()(2[+1],)
       *   reqs(req)(2[+1])
       *   decs:ifcons()(2[+1],)
       *   decs(dec)(2[+1])
       *   +1 "end"
       * }
       * @format:req({id, loc})
       * !N0{ "_require" +1 id }
       *)
      {
        interfaceId: InterfaceID.id,
        interfaceName: InterfaceName.interface_name,
        requiredIds: {id: InterfaceID.id, loc: loc} list,
        provideTopdecs: AbsynInterface.topdec list
      }

  (*%
   * @formatter(ifcons) AbsynFormatterUtils.ifcons
   * @formatter(InterfaceID.id) InterfaceID.format_id
   * @formatter(AbsynInterface.topdec) AbsynInterface.format_topdec
   * @formatter(Absyn.topdec) AbsynFormatter.format_topdec
   *)
  type 'loc interface =
      (*%
       * @format(
       *   {interfaceDecs: dec decs,
       *    provide:
       *      {requiredIds: req reqs,
       *       locallyRequiredIds: lreq lreqs,
       *       provideTopdecs: topdec topdecs,
       *       topdecsInclude: inc incs}}
       * )
       * !N0{
       *   decs(dec)(+1)
       *   decs:ifcons()(+1,)
       *   !N0{
       *     "_provide"
       *     reqs:ifcons()(2[+1],)
       *     reqs(req)(2[+1])
       *     lreqs:ifcons()(2[+1],)
       *     lreqs(lreq)(2[+1])
       *     topdecs:ifcons()(2[+1],)
       *     topdecs(topdec)(2[+1])
       *     +1 "end"
       *   }
       *   +1
       *   !N0{
       *     "include"
       *     incs:ifcons()(2[+1],)
       *     incs(inc)(2[+1])
       *     +1 "end"
       *   }
       * }
       * @format:req({id, loc})
       * !N0{ "_require" +1 id }
       * @format:lreq({id, loc})
       * !N0{ "_require" +d "local" +1 id }
       *)
      {
        interfaceDecs : interface_dec list,
        provide :
          {requiredIds : {id : InterfaceID.id, loc : 'loc} list,
           locallyRequiredIds : {id : InterfaceID.id, loc : 'loc} list,
           provideTopdecs : AbsynInterface.topdec list,
           topdecsInclude: Absyn.topdec list}
      }

  (*%
   * @formatter(ifcons) AbsynFormatterUtils.ifcons
   * @formatter(ifsome) AbsynFormatterUtils.ifsome
   * @formatter(Absyn.topdec) AbsynFormatter.format_topdec
   *)
  type compile_unit =
      (*%
       * @format({interface:i interface interfaceOpt, topdecsSource: dec decs})
       * !N0{
       *   interfaceOpt(interface()())
       *   interfaceOpt:ifsome()(decs:ifcons()(+1,),)
       *   decs(dec)(+1)
       * }
       *)
      {
        interface : loc interface option,
        topdecsSource : Absyn.topdec list
      }

  (* an interface loaded as if it is "_require"-ed *)
  (*%
   * @formatter(ifcons) AbsynFormatterUtils.ifcons
   * @formatter(InterfaceID.id) InterfaceID.format_id
   * @formatter(Absyn.topdec) AbsynFormatter.format_topdec
   *)
  type interface_unit =
      (*%
       * @format({interfaceDecs: dec decs,
       *          requiredIds: req reqs,
       *          topdecsInclude: inc incs})
       * !N0{
       *   decs(dec)(+1)
       *   decs:ifcons()(+1,)
       *   !N0{
       *     "_provide"
       *     reqs:ifcons()(2[+1],)
       *     reqs(req)(2[+1])
       *     incs:ifcons()(2[+1],)
       *     incs(inc)(2[+1])
       *     +1 "end"
       *   }
       * }
       * @format:req({id, loc})
       * !N0{ "_require" +1 id }
       *)
      {
        interfaceDecs : interface_dec list,
        requiredIds : {id : InterfaceID.id, loc : unit} list,
        topdecsInclude : Absyn.topdec list
      }

end
