(* _require local "../../../../basis.smi" *)
_require "../../../data/symbols/main/RecordLabel.smi"
_require "./RequirePath.smi"
_require "./AbsynTy.smi"
_require "./AbsynConst.smi"
_require "./AbsynSQL.smi"

structure Absyn =
struct

  datatype constant = datatype AbsynConst.constant

  type strid = AbsynTy.id
  type sigid = AbsynTy.id
  type funid = AbsynTy.id
  type longstrid = AbsynTy.longid

  type pos = AbsynTy.pos
  type loc = AbsynTy.loc
  type id = AbsynTy.id
  type longid = AbsynTy.longid
  type vid = AbsynTy.vid
  type longvid = AbsynTy.longvid
  type op_longvid = AbsynTy.op_longvid
  type tycon = AbsynTy.tycon
  type longtycon = AbsynTy.longtycon
  type lab = AbsynTy.lab
  type tyvar = AbsynTy.tyvar
  type tyvarseq = AbsynTy.tyvarseq
  datatype ty = datatype AbsynTy.ty
  datatype kind = datatype AbsynTy.kind
  type kinded_tyvar = AbsynTy.kinded_tyvar
  type bound_tyvars = AbsynTy.bound_tyvars
  type tyrow = AbsynTy.tyrow
  type tyseq = AbsynTy.tyseq
  type kinded_tyvarseq = AbsynTy.kinded_tyvarseq
  type ffi_attr = AbsynTy.ffi_attr
  datatype ffi_ty = datatype AbsynTy.ffi_ty
  type ffi_tyrow = AbsynTy.ffi_tyrow
  type ffi_tyseq = AbsynTy.ffi_tyseq
  type ffi_arg = AbsynTy.ffi_arg
  type ffi_ret = AbsynTy.ffi_ret

  type op_vid = bool * vid * loc

  type require_path = RequirePath.path * loc

  type extern_name = string * loc

  type exist_quant = kinded_tyvar list * loc

  datatype pat =
      PATWILD of loc
    | PATCONST of constant * loc
    | PATID of op_longvid
    | PATRECORD of patrow list * bool * loc
    | PATTUPLE of pat list * loc
    | PATLIST of pat list * loc
    | PATPAREN of pat * loc
    | PATAPP of pat * pat * loc
    | PATINFIX of pat * vid * pat * loc
    | PATTYPED of pat * ty * loc
    | PATAS of op_vid * ty option * pat * loc

  and patrow =
      PATROW of lab * pat * loc
    | PATROWVAR of vid * ty option * pat option * loc

  datatype exbind =
      EXBIND of op_vid * ty option * loc
    | EXBINDREP of op_vid * op_longvid * loc

  type typbind = tyvarseq option * tycon * ty * loc

  type conbind = op_vid * ty option * loc

  type datbind = tyvarseq option * tycon * conbind list * loc

  datatype exp =
      EXPCONST of constant * loc
    | EXPID of bool * longvid * loc
    | EXPRECORD of (lab * exp * loc) list * loc
    | EXPSELECT of lab * loc
    | EXPTUPLE of exp list * loc
    | EXPLIST of exp list * loc
    | EXPSEQ of exp list * loc
    | EXPLET of dec list * exp list * loc
    | EXPPAREN of exp * loc
    | EXPAPP of exp * exp * loc
    | EXPINFIX of exp * vid * exp * loc
    | EXPTYPED of exp * ty * loc
    | EXPANDALSO of exp * exp * loc
    | EXPORELSE of exp * exp * loc
    | EXPHANDLE of exp * (pat * exp * loc) list * loc
    | EXPRAISE of exp * loc
    | EXPIF of exp * exp * exp * loc
    | EXPWHILE of exp * exp * loc
    | EXPCASE of exp * (pat * exp * loc) list * loc
    | EXPFN of (pat * exp * loc) list * loc
    | EXPSIZEOF of ty * loc
    | EXPRECORD_UPDATE of exp * (lab * exp * loc) list * loc
    | EXPTUPLE_UPDATE of exp * exp list * loc
    | EXPIMPORT_NAME of extern_name * ffi_ty * loc
    | EXPIMPORT_EXP of exp * ffi_ty * loc
    | EXPSQL of (exp, pat, ty) AbsynSQL.top
    | EXPFOREACH_DATA of vid * exp * exp * pat * exp * exp * loc
    | EXPFOREACH_ARRAY of vid * exp * pat * exp * exp * loc
    | EXPJOIN of exp * exp * loc
    | EXPEXTEND of exp * exp * loc
    | EXPUPDATE1 of exp * exp * loc
    | EXPUPDATE2 of exp * exp * loc
    | EXPDYNAMIC_AS of exp * ty * loc
    | EXPDYNAMIC_OF of exp * ty * loc
    | EXPDYNAMICVIEW of exp * ty * loc
    | EXPDYNAMICNULL of ty * loc
    | EXPDYNAMICTOP of ty * loc
    | EXPDYNAMICCASE of exp * (exist_quant option * pat * exp * loc) list * loc
    | EXPREIFYTY of ty * loc

  and valbind =
      VALBIND of pat * exp * loc
    | VALREC of valbind list * loc

  and dec =
      DECVAL of kinded_tyvarseq option * valbind list * loc
    | DECFUN of kinded_tyvarseq option
                * ((pat * ty option * exp * loc) list * loc) list
                * loc
    | DECTYPE of typbind list * loc
    | DECDATATYPE of datbind list * typbind list * loc
    | DECDATATYPEREP of tycon * longtycon * loc
    | DECABSTYPE of datbind list * typbind list * dec list * loc
    | DECEXCEPTION of exbind list * loc
    | DECLOCAL of dec list * dec list * loc
    | DECOPEN of longstrid list * loc
    | DECSEMICOLON of loc
    | DECINFIX of string option * vid list * loc
    | DECINFIXR of string option * vid list * loc
    | DECNONFIX of vid list * loc
    | DECPOLYREC of (vid * ty * exp * loc) list * loc

  type sqlexp = (exp, pat, ty) AbsynSQL.top

  type exprow = lab * exp * loc

  type mrule = pat * exp * loc

  type dynamic_mrule = exist_quant option * pat * exp * loc

  type frule = pat * ty option * exp * loc

  type fvalbind = frule list * loc

  type pvalbind = vid * ty * exp * loc

  type valdesc = vid * ty * loc

  type typdesc = tyvarseq option * tycon * loc

  type condesc = vid * ty option * loc

  type datdesc = tyvarseq option * tycon * condesc list * loc

  type exdesc = vid * ty option * loc

  type wheretype = tyvarseq option * longtycon * ty * loc

  datatype spec =
      SPECVAL of valdesc list * loc
    | SPECTYPE of typdesc list * loc
    | SPECTYPEINC of typbind list * loc
    | SPECEQTYPE of typdesc list * loc
    | SPECDATATYPE of datdesc list * loc
    | SPECDATATYPEREP of tycon * longtycon * loc
    | SPECEXCEPTION of exdesc list * loc
    | SPECSTRUCTURE of (strid * sigexp * loc) list * loc
    | SPECINCLUDE of sigexp * loc
    | SPECINCLUDE_ID of sigid list * loc
    | SPECSHARINGTYPE of spec list * longtycon list * loc
    | SPECSHARING of spec list * longstrid list * loc
    | SPECSEMICOLON of loc

  and sigexp =
      SIGBASIC of spec list * loc
    | SIGID of sigid
    | SIGWHERE of sigexp * wheretype list * loc

  type strdesc = strid * sigexp * loc

  type sigbind = sigid * sigexp * loc

  datatype sigop =
      TRANSPARENT
    | OPAQUE

  type sigconstraint = sigop * sigexp * loc

  datatype strexp =
      STRBASIC of strdec list * loc
    | STRID of longstrid
    | STRCONSTRAINT of strexp * sigop * sigexp * loc
    | STRAPP of funid * fun_arg * loc
    | STRLET of strdec list * strexp * loc

  and strdec =
      STRDEC of dec
    | STRUCTURE of (strid * sigconstraint option * strexp * loc) list * loc
    | STRLOCAL of strdec list * strdec list * loc
    | STRSEMICOLON of loc

  and fun_arg =
      FUNARG of strexp
    | FUNARG_DEC of strdec list

  type strbind = strid * sigconstraint option * strexp * loc

  datatype fun_param =
      FUNPARAM of strid * sigexp
    | FUNPARAM_SPEC of spec list

  type funbind = funid * fun_param * sigconstraint option * strexp * loc

  datatype topdec =
      TOPSTRDEC of strdec
    | TOPSIGNATURE of sigbind list * loc
    | TOPFUNCTOR of funbind list * loc
    | TOPEXP of exp * loc

  datatype top =
      TOPDEC of topdec list * loc
    | USE of require_path * loc
    | USE' of require_path * loc
    | TOPSEMICOLON of loc

  type interface = require_path * loc

  type compile_unit = interface option * top list * loc

  datatype absyn =
      UNIT of compile_unit
    | EOF of pos

end
