(* _require local "../../../../basis.smi" *)
_require "../../../data/symbols/main/Loc.smi"
_require "../../../data/symbols/main/Symbol.smi"
_require "../../../data/symbols/main/RecordLabel.smi"

structure AbsynTy =
struct

  type pos = Loc.pos
  type loc = pos * pos

  type id = Symbol.symbol * loc

  type longid = id list * loc

  type vid = id

  type longvid = longid

  type tycon = id

  type longtycon = longid

  type lab = RecordLabel.label * loc

  type tyvar = bool * id

  type tyvarseq = tyvar list * loc

  type op_longvid = bool * longvid * loc

  datatype ty =
      TYVAR of tyvar
    | TYRECORD of (lab * ty * loc) list * bool * loc
    | TYCON of (ty list * loc) option * longtycon * loc
    | TYTUPLE of ty list * loc
    | TYFUN of ty * ty * loc
    | TYPAREN of ty * loc
    | TYWILD of loc
    | TYVAR_FREE of tyvar * kind option * loc
    | TYPOLY of (tyvar * kind option * loc) list * ty * loc

  and kind =
      UNIV of id list * loc
    | REC of id list * (lab * ty * loc) list * loc

  type kinded_tyvar = tyvar * kind option * loc

  type tyrow = lab * ty * loc

  type tyseq = ty list * loc

  type kinded_tyvarseq = kinded_tyvar list * loc

  type ffi_attr = id list * loc

  datatype ffi_ty =
      FFITYVAR of tyvar
    | FFITYRECORD of (lab * ffi_ty * loc) list * loc
    | FFITYCON of (ffi_ty list * loc) option * longtycon * loc
    | FFITYTUPLE of ffi_ty list * loc
    | FFITYFUN of ffi_attr option
                  * (ffi_ty list * ffi_ty list option * loc)
                  * (ffi_ty list * loc)
                  * loc
    | FFITYPAREN of ffi_ty * loc

  type ffi_tyrow = lab * ffi_ty * loc

  type ffi_tyseq = ffi_ty list * loc

  type ffi_arg = ffi_ty list * ffi_ty list option * loc

  type ffi_ret = ffi_ty list * loc

end
