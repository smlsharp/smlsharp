(* a grammar for the raw symtax of IML.
 * @copyright (C) 2021 SML# Development Team.
 * @author Atsushi Ohori, Kiyoshi Yamatodani, Liu Bochao
 * @version $Id: iml.grm,v 1.69.6.8 2010/02/10 05:17:29 hiro-en Exp $

 * Ohori: 2007/11/11
 * WARNING: Large part of this file is copied to interface.grm.
 * I indicates those positons that are from iml.grm in interface.grm.
 * iml.grm is the original. If one change something there, he/she
 * must propagate the change here.
 * This is unsatisfactory situation. We will consider a better
 * organization later.

 * Ohori: 2012/10/9
   id, longid are systematically changed to symbol and longsymbol
   having location information.

 * Ohori: 2013/06/29
   Changed id to represent symbols.

 * Ohori: 2015/09/24
   Added SYMBOLICID and ALPHABETICID to restrict
   structure and functor ids to alphabetic.
*)

structure A = Absyn
structure S = AbsynSQL

fun EXPAPP (NIL ::> exp, loc) = exp
  | EXPAPP (exps, loc) = A.EXPAPP (Snoc.toList exps, loc)
fun PATAPP (NIL ::> pat, loc) = pat
  | PATAPP (pats, loc) = A.PATAPP (Snoc.toList pats, loc)
fun S_APP (NIL ::> exp, loc) = exp
  | S_APP (exps, loc) = S.APP (Snoc.toList exps, loc)
fun PATID (id, loc) =
    A.PATID (false, ([id], loc), loc)
fun OP_PATID (id, pos1, loc as (_, pos3)) =
    A.PATID (true, ([id], loc), (pos1, pos3))

%%

%name ImlGrm
%header (structure ImlGrm)
%footer ()
%pure
%verbose

%pos A.pos

%term
    EOF
  | INVALID of string
    (* core keywords *)
  | ABSTYPE
  | AND
  | ANDALSO
  | AS
  | CASE
  | DATATYPE
  | DO
  | ELSE
  | END
  | EXCEPTION
  | FN
  | FUN
  | HANDLE
  | IF
  | IN
  | INFIX
  | INFIXR
  | LET
  | LOCAL
  | NONFIX
  | OF
  | OP
  | OPEN
  | ORELSE
  | RAISE
  | REC
  | THEN
  | TYPE
  | VAL
  | WITH
  | WITHTYPE
  | WHILE
  | LPAREN
  | RPAREN
  | LBRACKET
  | RBRACKET
  | LBRACE
  | RBRACE
  | COMMA
  | COLON
  | SEMICOLON
  | PERIODS
  | UNDERBAR
  | BAR
  | EQ
  | DARROW
  | ARROW
  | HASH
    (* module keywords *)
  | EQTYPE
  | FUNCTOR
  | INCLUDE
  | SHARING
  | SIG
  | SIGNATURE
  | STRUCT
  | STRUCTURE
  | WHERE
  | OPAQUE
    (* special symbols *)
  | ASTERISK
  | PERIOD
    (* SML# extensions *)
  | U_ATTRIBUTE
  | U_BUILTIN
  | U_FOREACH
  | U_IMPORT
  | U_INTERFACE
  | U_JOIN
  | U_EXTEND
  | U_UPDATE
  | U_DYNAMIC
  | U_DYNAMICCASE
  | U_DYNAMICNULL
  | U_DYNAMICVIEW
  | U_DYNAMICVOID
  | U_POLYREC
  | U_REIFYTY
  | U_REQUIRE
  | U_SIZEOF
  | U_SQL
  | U_SQLEVAL
  | U_SQLEXEC
  | U_SQLSERVER
  | U_USE
    (* identifiers *)
  | ALNUMID of string
  | EQTYVAR of string
  | FREE_TYVAR of string
  | FREE_EQTYVAR of string
  | PREFIXEDLABEL of string
  | SYMBOLID of string
  | TYVAR of string
    (* scon *)
  | CHAR of string
  | HASH_STRING of string
  | INT of string
  | INTX of string
  | INTLAB of string
  | REAL of string
  | STRING of string
  | WORD of string
  | WORDX of string
   (* metacommands *)
  | USE
   (* SQL keywords *)
  | ALL
  | ASC
  | BEGIN
  | BY
  | COMMIT
  | CROSS
  | DEFAULT
  | DELETE
  | DESC
  | DISTINCT
  | EXISTS
  | FALSE
  | FETCH
  | FIRST
  | FROM
  | GROUP
  | HAVING
  | INNER
  | INSERT
  | INTO
  | IS
  | JOIN
  | LIMIT
  | NATURAL
  | NEXT
  | NOT
  | NULL
  | OFFSET
  | ON
  | ONLY
  | OR
  | ORDER
  | ROLLBACK
  | ROW
  | ROWS
  | SELECT
  | SET
  | TRUE
  | UNKNOWN
  | UPDATE
  | VALUES

%nonterm
    start of A.absyn
  | int of string
  | constant of A.constant
  | alphabetic_id of A.id
  | id_noEQSTAR of A.id
  | id_noEQ of A.id
  | id_noSTAR of A.id
  | id of A.id
  | id_noEQSQL of A.id
  | id_noSQL of A.id
  | longid of A.longid
  | longid_noID of A.longid
  | longstrid of A.longstrid
  | longtycon of A.longtycon
  | longtycon_noEQ of A.longtycon
  | vids of A.vid list
  | longstrids of A.longstrid list
  | atexp_noID of A.exp
  | atexp of A.exp
  | lab of A.lab
  | exprow_1 of A.exprow
  | exprow of A.exprow snoc
  | exps_comma of A.exp snoc
  | exps_semicolon of A.exp snoc
  | appexp of A.exp snoc
  | colonexp of A.exp
  | conjexp of A.exp
  | conjexp_r of A.exp
  | disjexp of A.exp
  | disjexp_r of A.exp
  | handleexp of A.exp
  | miscexp of A.exp
  | exp of A.exp
  | expOrSQL of A.exp
  | match of A.mrule list
  | dynmatch of A.dynamic_mrule list
  | exist_quant of A.exist_quant
  | sql of A.exp
  | sqlparen of A.exp S.sql
  | sqlstep of A.exp S.step
  | sqlsteps of A.exp S.step list
  | sql_opt of bool
  | sqlcon of A.exp S.sqlcon
  | sqlSelect of A.exp S.select
  | sqlSelectOrExp of A.exp S.select
  | sqlquery of A.exp S.query
  | sqlFrom of A.exp S.from
  | sqlWhere of A.exp S.whr
  | sqlWhereOpt of A.exp S.whr option
  | sqlGroupbyOpt of A.exp S.groupby option
  | sqlOrderby of A.exp S.orderby
  | sqlOrderbyOpt of A.exp S.orderby option
  | sqlLimit of A.exp S.limit
  | sqlOffset of A.exp S.offset
  | sqlOffsetOrLimitOpt of A.exp S.offset_or_limit option
  | sqlfirst of S.first_next
  | sqlrows of S.row_rows
  | sqldistinct of S.distinct_all option
  | sqlSelectList of A.exp S.select_row list
  | sqlSelectRow of A.exp S.select_row
  | sqlOrderKeys of A.exp S.order_key list
  | sqlOrderKey of A.exp S.order_key
  | sqljoins of A.exp S.table list
  | sqljoin of A.exp S.table
  | sqltableAs of A.exp S.table
  | sqltableExp of A.exp S.table
  | sqltable of S.table_selector
  | sqlInsert of A.exp S.sqlcon
  | sqlInsertLabels of A.lab list
  | sqlInsertValues of A.exp S.insert_values
  | sqlInsertRow of A.exp S.insert_row
  | sqlInsertRows of A.exp S.insert_row list
  | sqlInsertRowValue of A.exp S.insert_value
  | sqlInsertRowValues of A.exp S.insert_value list
  | sqlUpdate of A.exp S.sqlcon
  | sqlsetrow of A.exp S.set_row
  | sqlsetrows of A.exp S.set_row list
  | sqlDelete of A.exp S.sqlcon
  | sqlatexp of A.exp S.exp
  | sqlkwexp of A.exp S.kwexp
  | sqlappexp of A.exp S.exp snoc
  | sqlnotexp of A.exp S.exp
  | sqlconjexp of A.exp S.exp
  | sqlexp of A.exp S.exp
  | sqlexp_noAND of A.exp S.exp
  | sqlexps of A.exp S.exp list
  | sqlexps_noAND of A.exp S.exp list
  | sqlapppat_noID of A.pat snoc
  | sqlpat of A.pat
  | decs of A.dec list
  | dec of A.dec
  | prec of string option
  | typbind_1 of A.typbind
  | typbind of A.typbind list
  | datbind_1 of A.datbind
  | datbind of A.datbind list
  | op_opt of bool
  | conbind_1 of A.conbind
  | conbind of A.conbind list
  | exbind_1 of A.exbind
  | exbind of A.exbind list
  | tyvar of A.tyvar
  | free_tyvar of A.tyvar
  | tyvarseq of A.tyvarseq
  | tyvars_comma of A.tyvar list
  | valbind_1 of A.valbind
  | valbind of A.valbind list
  | pvalbind_1 of A.pvalbind
  | pvalbind of A.pvalbind list
  | frule of A.frule
  | fvalbind_1 of A.fvalbind
  | fvalbind of A.fvalbind list
  | atpat_noID_noPAREN of A.pat
  | atpat_noID of A.pat
  | atpat of A.pat
  | apppat_noID of A.pat snoc
  | apppat of A.pat snoc
  | apppat_COLON_ty of A.pat snoc * A.loc * A.ty
  | aspat of A.pat
  | pat of A.pat
  | colon_ty_opt of A.ty option
  | patrow_1 of A.patrow
  | patrow of A.patrow list * bool
  | pats_comma of A.pat snoc
  | tyrow_1 of A.tyrow
  | tyrow of A.tyrow list
  | tyrow_flex of A.tyrow list * bool
  | atty of A.ty
  | appty of A.ty
  | tyseq of A.tyseq
  | tys_comma of A.ty list
  | tytuple of A.ty list
  | tuplety of A.ty
  | ty of A.ty
  | poly_tyrow_1 of A.tyrow
  | poly_tyrow of A.tyrow list
  | poly_ty1 of A.ty
  | poly_tytuple of A.ty list
  | poly_ty of A.ty
  | kind of A.id list * A.tyrow list option
  | kinded_tyvar of A.kinded_tyvar
  | kinded_free_tyvar of A.kinded_tyvar
  | kinded_tyvarseq of A.kinded_tyvarseq
  | kinded_tyvars_comma of A.kinded_tyvar list
  | kinded_tyvars of A.kinded_tyvar list
  | ffityrow_1 of A.ffi_tyrow
  | ffityrow of A.ffi_tyrow list
  | ffitys of A.ffi_ty list
  | ffitys_opt of A.ffi_ty list
  | ffitys_COMMA of A.ffi_ty list
  | ffityseq of A.ffi_tyseq
  | ffiatty of A.ffi_ty
  | ffitytuple of A.ffi_ty list
  | ffituplety of A.ffi_ty
  | ffiarg of A.ffi_arg
  | ffiret of A.ffi_ret
  | ffifunty of A.ffi_ty
  | ffiattrs of A.id list
  | ffiattr of A.ffi_attr
  | ffity of A.ffi_ty
  | strexpbasic of A.strexp
  | funarg of A.fun_arg
  | strexp of A.strexp
  | strexp_AND of A.strexp * A.pos
  | strdecs of A.strdec list
  | strdec of A.strdec
  | strbind of A.strbind
  | strbind_AND of A.strbind * A.pos
  | strbindseq of A.strbind list
  | sigexpbasic of A.sigexp
  | wheretype of A.wheretype
  | sigexpwhere of A.sigexp * A.wheretype snoc
  | sigexp of A.sigexp
  | sigexp_AND of A.sigexp * A.pos
  | sigbind of A.sigbind list
  | longtycons_eq of A.longtycon list
  | longstrids_eq of A.longstrid list
  | spec of A.spec snoc
  | atomicspec of A.spec
  | sigids of A.sigid list
  | valdesc_1 of A.valdesc
  | valdesc of A.valdesc list
  | typdesc_1 of A.typdesc
  | typdesc of A.typdesc list
  | datdesc_1 of A.datdesc
  | datdesc of A.datdesc list
  | condesc_1 of A.condesc
  | condesc of A.condesc list
  | exdesc of A.exdesc list
  | strdesc of A.strdesc list
  | funparam of A.fun_param
  | funsig of A.sigconstraint option
  | funbind_1 of A.funbind
  | funbind_1_AND of A.funbind
  | funbind of A.funbind list
  | topdecs of A.topdec list
  | topdec of A.topdec
  | topuse of A.top
  | tops of A.top list
  | interface of A.interface
  | compile_unit of A.absyn

%start start
%eop EOF SEMICOLON
%noshift EOF

%nonassoc DARROW
%nonassoc BAR

(* for error recovery *)
%keyword
  ABSTYPE AND ANDALSO AS CASE DATATYPE DO ELSE END EXCEPTION FN FUN HANDLE
  IF IN INFIX INFIXR LET LOCAL NONFIX OF OP OPEN ORELSE RAISE REC THEN TYPE
  VAL WITH WITHTYPE WHILE
  EQTYPE FUNCTOR INCLUDE SHARING SIG SIGNATURE STRUCT STRUCTURE WHERE
%value TYVAR ("")
%value ALNUMID ("")
%change -> SEMICOLON | -> VAL | -> LPAREN | -> TYVAR | -> ALNUMID

%%

start
        : compile_unit
          (compile_unit)
        | expOrSQL
          (A.UNIT
             (NONE,
              [A.TOPDEC
                 ([A.TOPEXP (expOrSQL, (expOrSQLleft, expOrSQLright))],
                  (expOrSQLleft, expOrSQLright))],
              (expOrSQLleft, expOrSQLright)))

(****************** constant ***************************)
int
        : INT
          (INT)
        | INTLAB
          (INTLAB)

constant
        : int
          (A.INT (valOf (StringCvt.scanString
                           (IntInf.scan StringCvt.DEC)
                           int)))
        | INTX
          (A.INT (valOf (StringCvt.scanString
                           (IntInf.scan StringCvt.HEX)
                           INTX)))
        | WORD
          (A.WORD (valOf (StringCvt.scanString
                            (IntInf.scan StringCvt.DEC)
                            (String.extract (WORD, 2, NONE)))))
        | WORDX
          (A.WORD (valOf (StringCvt.scanString
                            (IntInf.scan StringCvt.HEX)
                            (String.extract (WORDX, 3, NONE)))))
        | STRING
          (A.STRING STRING)
        | REAL
          (A.REAL REAL)
        | CHAR
          (A.CHAR (String.sub (CHAR, 0)))

alphabetic_id
        : ALNUMID
          (Symbol.fromString ALNUMID,
           (ALNUMIDleft, ALNUMIDright))
        | ALL
          (Symbol.fromString "all", (ALLleft, ALLright))
        | ASC
          (Symbol.fromString "asc", (ASCleft, ASCright))
        | BEGIN
          (Symbol.fromString "begin", (BEGINleft, BEGINright))
        | BY
          (Symbol.fromString "by", (BYleft, BYright))
        | COMMIT
          (Symbol.fromString "commit", (COMMITleft, COMMITright))
        | CROSS
          (Symbol.fromString "cross", (CROSSleft, CROSSright))
        | DEFAULT
          (Symbol.fromString "default", (DEFAULTleft, DEFAULTright))
        | DELETE
          (Symbol.fromString "delete", (DELETEleft, DELETEright))
        | DESC
          (Symbol.fromString "desc", (DESCleft, DESCright))
        | DISTINCT
          (Symbol.fromString "distinct", (DISTINCTleft, DISTINCTright))
        | EXISTS
          (Symbol.fromString "exists", (EXISTSleft, EXISTSright))
        | FALSE
          (Symbol.fromString "false", (FALSEleft, FALSEright))
        | FETCH
          (Symbol.fromString "fetch", (FETCHleft, FETCHright))
        | FIRST
          (Symbol.fromString "first", (FIRSTleft, FIRSTright))
        | FROM
          (Symbol.fromString "from", (FROMleft, FROMright))
        | GROUP
          (Symbol.fromString "group", (GROUPleft, GROUPright))
        | HAVING
          (Symbol.fromString "having", (HAVINGleft, HAVINGright))
        | INNER
          (Symbol.fromString "inner", (INNERleft, INNERright))
        | INSERT
          (Symbol.fromString "insert", (INSERTleft, INSERTright))
        | INTO
          (Symbol.fromString "into", (INTOleft, INTOright))
        | IS
          (Symbol.fromString "is", (ISleft, ISright))
        | JOIN
          (Symbol.fromString "join", (JOINleft, JOINright))
        | LIMIT
          (Symbol.fromString "limit", (LIMITleft, LIMITright))
        | NATURAL
          (Symbol.fromString "natural", (NATURALleft, NATURALright))
        | NEXT
          (Symbol.fromString "next", (NEXTleft, NEXTright))
        | NOT
          (Symbol.fromString "not", (NOTleft, NOTright))
        | NULL
          (Symbol.fromString "null", (NULLleft, NULLright))
        | OFFSET
          (Symbol.fromString "offset", (OFFSETleft, OFFSETright))
        | ON
          (Symbol.fromString "on", (ONleft, ONright))
        | ONLY
          (Symbol.fromString "only", (ONLYleft, ONLYright))
        | OR
          (Symbol.fromString "or", (ORleft, ORright))
        | ORDER
          (Symbol.fromString "order", (ORDERleft, ORDERright))
        | ROLLBACK
          (Symbol.fromString "rollback", (ROLLBACKleft, ROLLBACKright))
        | ROW
          (Symbol.fromString "row", (ROWleft, ROWright))
        | ROWS
          (Symbol.fromString "rows", (ROWSleft, ROWSright))
        | SELECT
          (Symbol.fromString "select", (SELECTleft, SELECTright))
        | SET
          (Symbol.fromString "set", (SETleft, SETright))
        | TRUE
          (Symbol.fromString "true", (TRUEleft, TRUEright))
        | UNKNOWN
          (Symbol.fromString "unknown", (UNKNOWNleft, UNKNOWNright))
        | UPDATE
          (Symbol.fromString "update", (UPDATEleft, UPDATEright))
        | VALUES
          (Symbol.fromString "values", (VALUESleft, VALUESright))

id_noEQSTAR
        : alphabetic_id
          (alphabetic_id)
        | SYMBOLID
          (Symbol.fromString SYMBOLID, (SYMBOLIDleft, SYMBOLIDright))

id_noEQ
        : id_noEQSTAR
          (id_noEQSTAR)
        | ASTERISK
          (Symbol.fromString "*", (ASTERISKleft, ASTERISKright))

id_noSTAR
        : id_noEQSTAR
          (id_noEQSTAR)
        | EQ
          (Symbol.fromString "=", (EQleft, EQright))

id
        : id_noEQ
          (id_noEQ)
        | EQ
          (Symbol.fromString "=", (EQleft, EQright))

id_noEQSQL
        : ALNUMID
          (Symbol.fromString ALNUMID, (ALNUMIDleft, ALNUMIDright))
        | SYMBOLID
          (Symbol.fromString SYMBOLID, (SYMBOLIDleft, SYMBOLIDright))
        | ASTERISK
          (Symbol.fromString "*", (ASTERISKleft, ASTERISKright))

id_noSQL
        : id_noEQSQL
          (id_noEQSQL)
        | EQ
          (Symbol.fromString "=", (EQleft, EQright))

longid
        : id
          ([id], (idleft, idright))
        | alphabetic_id PERIOD longid
          (alphabetic_id :: #1 longid, (alphabetic_idleft, longidright))

longid_noID
        : alphabetic_id PERIOD longid
          (alphabetic_id :: #1 longid, (alphabetic_idleft, longidright))

longstrid
        : alphabetic_id
          ([alphabetic_id], (alphabetic_idleft, alphabetic_idright))
        | alphabetic_id PERIOD longstrid
          (alphabetic_id :: #1 longstrid, (alphabetic_idleft, longstridright))

longtycon
        : id_noSTAR
          ([id_noSTAR], (id_noSTARleft, id_noSTARright))
        | alphabetic_id PERIOD longtycon
          (alphabetic_id :: #1 longtycon, (alphabetic_idleft, longtyconright))

longtycon_noEQ
        : id_noEQSTAR
          ([id_noEQSTAR], (id_noEQSTARleft, id_noEQSTARright))
        | alphabetic_id PERIOD longtycon
          (alphabetic_id :: #1 longtycon, (alphabetic_idleft, longtyconright))

vids
        : id
          ([id])
        | id vids
          (id :: vids)

longstrids
        : longstrid
          ([longstrid])
        | longstrid longstrids
          (longstrid :: longstrids)

(*** expressions ***)

atexp_noID
        : constant
          (A.EXPCONST (constant, (constantleft, constantright)))
        | U_JOIN LPAREN exp COMMA exp RPAREN
          (A.EXPJOIN (exp1, exp2, (U_JOINleft, RPARENright)))
        | U_EXTEND LPAREN exp COMMA exp RPAREN
          (A.EXPEXTEND (exp1, exp2, (U_EXTENDleft, RPARENright)))
        | U_UPDATE LPAREN exp COMMA exp RPAREN
          (A.EXPUPDATE1 (exp1, exp2, (U_UPDATEleft, RPARENright)))
        | OP longid
          (A.EXPID (true, longid, (OPleft, longidright)))
        | U_SIZEOF LPAREN ty RPAREN
          (A.EXPSIZEOF (ty, (U_SIZEOFleft, RPARENright)))
        | LBRACE exprow RBRACE
          (A.EXPRECORD (Snoc.toList exprow, (LBRACEleft, RBRACEright)))
        | LBRACE RBRACE
          (A.EXPRECORD (nil, (LBRACEleft, RBRACEright)))
        | LPAREN RPAREN
          (A.EXPCONST (A.UNITCONST, (LPARENleft, RPARENright)))
        | HASH lab
          (A.EXPSELECT (lab, (HASHleft, labright)))
        | HASH_STRING
          (let val loc = (HASH_STRINGleft, HASH_STRINGright)
           in A.EXPSELECT ((RecordLabel.fromString HASH_STRING, loc), loc)
           end)
        | LBRACKET RBRACKET
          (A.EXPLIST (nil, (LBRACKETleft, RBRACKETright)))
        | LBRACKET expOrSQL RBRACKET
          (A.EXPLIST ([expOrSQL], (LBRACKETleft, RBRACKETright)))
        | LBRACKET exps_comma RBRACKET
          (A.EXPLIST (Snoc.toList exps_comma, (LBRACKETleft, RBRACKETright)))
        | LET decs IN exps_semicolon END
          (A.EXPLET (decs, Snoc.toList exps_semicolon, (LETleft, ENDright)))
        | U_REIFYTY LPAREN ty RPAREN
          (A.EXPREIFYTY (ty, (U_REIFYTYleft, RPARENright)))
        | U_SQL sqlparen
          (A.EXPSQL (S.SQL (sqlparen, (U_SQLleft, sqlparenright))))
        | LPAREN exps_comma RPAREN
          (A.EXPTUPLE (Snoc.toList exps_comma, (LPARENleft, RPARENright)))
        | LPAREN expOrSQL SEMICOLON exps_semicolon RPAREN
          (A.EXPSEQ
             (expOrSQL :: Snoc.toList exps_semicolon,
              (LPARENleft, RPARENright)))
        | LPAREN expOrSQL RPAREN
          (A.EXPPAREN (expOrSQL, (LPARENleft, RPARENright)))
        | U_FOREACH id IN exp WHERE exp WITH pat DO exp WHILE exp END
          (A.EXPFOREACH_DATA
             (id, exp1, exp2, pat1, exp3, exp4, (U_FOREACHleft, ENDright)))
        | U_FOREACH id IN exp WITH pat DO exp WHILE exp END
          (A.EXPFOREACH_ARRAY
             (id, exp1, pat, exp2, exp3, (U_FOREACHleft, ENDright)))

atexp
        : atexp_noID
          (atexp_noID)
        | longid
          (A.EXPID (false, longid, (longidleft, longidright)))

lab
        : id
          (RecordLabel.fromSymbol (#1 id), (idleft, idright))
        | INTLAB
          (RecordLabel.fromString INTLAB, (INTLABleft, INTLABright))
        | STRING
          (RecordLabel.fromString STRING, (STRINGleft, STRINGright))
        | PREFIXEDLABEL
          (RecordLabel.fromString PREFIXEDLABEL,
           (PREFIXEDLABELleft, PREFIXEDLABELright))

exprow_1
        : lab EQ exp
          (lab, exp, (lableft, expright))

exprow
        : exprow_1
          (NIL ::> exprow_1)
        | exprow COMMA exprow_1
          (exprow ::> exprow_1)

(* equal or more than 2 exps *)
exps_comma
        : exp COMMA exp
          (NIL ::> exp1 ::> exp2)
        | exps_comma COMMA exp
          (exps_comma ::> exp)

(* equal or more than 1 exps *)
exps_semicolon
        : expOrSQL
          (NIL ::> expOrSQL)
        | exps_semicolon SEMICOLON expOrSQL
          (exps_semicolon ::> expOrSQL)

appexp
        : atexp
          (NIL ::> atexp)
        | appexp atexp
          (appexp ::> atexp)
        | appexp HASH LBRACE atexp RBRACE
          (NIL
           ::> A.EXPUPDATE2
                 (EXPAPP (appexp, (appexpleft, appexpright)),
                  atexp,
                  (appexpleft, RBRACEright)))
        | appexp HASH LBRACE exprow RBRACE
          (NIL
           ::> A.EXPRECORD_UPDATE
                 (EXPAPP (appexp, (appexpleft, appexpright)),
                  Snoc.toList exprow,
                  (appexpleft, RBRACEright)))
        | appexp HASH LBRACE RBRACE
          (NIL
           ::> A.EXPRECORD_UPDATE
                 (EXPAPP (appexp, (appexpleft, appexpright)),
                  nil,
                  (appexpleft, RBRACEright)))
        | appexp HASH LPAREN exps_comma RPAREN
          (NIL
           ::> A.EXPTUPLE_UPDATE
                 (EXPAPP (appexp, (appexpleft, appexpright)),
                  Snoc.toList exps_comma,
                  (appexpleft, RPARENright)))

colonexp
        : appexp
          (EXPAPP (appexp, (appexpleft, appexpright)))
        | colonexp COLON ty
          (A.EXPTYPED (colonexp, ty, (colonexpleft, tyright)))
        | colonexp COLON U_IMPORT ffity
          (A.EXPIMPORT_EXP (colonexp, ffity, (colonexpleft, ffityright)))

conjexp
        : colonexp
          (colonexp)
        | conjexp ANDALSO colonexp
          (A.EXPANDALSO (conjexp, colonexp, (conjexpleft, colonexpright)))

disjexp
        : conjexp
          (conjexp)
        | disjexp ORELSE conjexp
          (A.EXPORELSE (disjexp, conjexp, (disjexpleft, conjexpright)))

miscexp
        : RAISE exp
          (A.EXPRAISE (exp, (RAISEleft, expright)))
        | IF exp THEN exp ELSE exp
          (A.EXPIF (exp1, exp2, exp3, (IFleft, exp3right)))
        | WHILE exp DO exp
          (A.EXPWHILE (exp1, exp2, (WHILEleft, exp2right)))
        | CASE exp OF match
          (A.EXPCASE (exp, match, (CASEleft, matchright)))
        | FN match
          (A.EXPFN (match, (FNleft, matchright)))
        | U_IMPORT STRING COLON ffity
          (A.EXPIMPORT_NAME
             ((STRING, (STRINGleft, STRINGright)),
              ffity,
              (U_IMPORTleft, ffityright)))
        | U_SQLSERVER COLON ty
          (A.EXPSQL (AbsynSQL.SQLSERVER (NONE, ty, (U_SQLSERVERleft, tyright))))
        | U_SQLSERVER colonexp COLON ty
          (A.EXPSQL
             (AbsynSQL.SQLSERVER
                (SOME colonexp, ty, (U_SQLSERVERleft, tyright))))
        | U_DYNAMIC exp AS ty
          (A.EXPDYNAMIC_AS (exp, ty, (U_DYNAMICleft, tyright)))
        | U_DYNAMIC exp OF ty
          (A.EXPDYNAMIC_OF (exp, ty, (U_DYNAMICleft, tyright)))
        | U_DYNAMICVIEW exp AS ty
          (A.EXPDYNAMICVIEW (exp, ty, (U_DYNAMICVIEWleft, tyright)))
        | U_DYNAMICNULL AS ty
          (A.EXPDYNAMICNULL (ty, (U_DYNAMICNULLleft, tyright)))
        | U_DYNAMICVOID AS ty
          (A.EXPDYNAMICTOP (ty, (U_DYNAMICVOIDleft, tyright)))
        | U_DYNAMICCASE exp OF dynmatch
          (A.EXPDYNAMICCASE (exp, dynmatch, (U_DYNAMICCASEleft, dynmatchright)))

exp
        : disjexp
          (disjexp)
        | disjexp HANDLE match
          (A.EXPHANDLE (disjexp, match, (disjexpleft, matchright)))
        | conjexp ANDALSO miscexp
          (A.EXPANDALSO (conjexp, miscexp, (conjexpleft, miscexpright)))
        | disjexp ORELSE miscexp
          (A.EXPORELSE (disjexp, miscexp, (disjexpleft, miscexpright)))
        | miscexp
          (miscexp)

expOrSQL
        : exp
          (exp)
        | sql
          (sql)

(*
It seems that the core ML's "|" has inherent problem, which coincides
with my experience. I have been bothered by the "|" in combination
with  case, fn, and  handle.
*)
match
        : pat DARROW exp
          ([(pat, exp, (patleft, expright))])
        | pat DARROW exp BAR match
          ((pat, exp, (patleft, expright)) :: match)

dynmatch
        : exist_quant pat DARROW exp
          ([(exist_quant, pat, exp, (exist_quantleft, expright))])
        | exist_quant pat DARROW exp BAR dynmatch
          ((exist_quant, pat, exp, (exist_quantleft, expright))
           :: dynmatch)
        | pat DARROW exp
          ([((nil, Loc.noloc), pat, exp, (patleft, expright))])
        | pat DARROW exp BAR dynmatch
          (((nil, Loc.noloc), pat, exp, (patleft, expright)) :: dynmatch)

exist_quant
        : LBRACE kinded_tyvar RBRACE
          ([kinded_tyvar], (LBRACEleft, RBRACEright))
        | LBRACE kinded_tyvars_comma RBRACE
          (kinded_tyvars_comma, (LBRACEleft, RBRACEright))

(*************************** sql ********************************)

sql
        : U_SQL sqlpat DARROW sql_opt sqlcon
          (A.EXPSQL
             (S.SQLFN
                (sqlpat,
                 S.CON (sql_opt, sqlcon, (sql_optleft, sqlconright)),
                 (U_SQLleft, sqlconright))))
        | U_SQL sqlpat DARROW PERIODS LPAREN expOrSQL RPAREN
          (A.EXPSQL
             (S.SQLFN
                (sqlpat,
                 S.SEQ
                   ([S.STEP_EMBED (expOrSQL, (PERIODSleft, RPARENright))],
                    (PERIODSleft, RPARENright)),
                 (U_SQLleft, RPARENright))))
        | U_SQL sqlpat DARROW sqlparen
          (A.EXPSQL (S.SQLFN (sqlpat, sqlparen, (U_SQLleft, sqlparenright))))
        | U_SQL sqlcon
          (A.EXPSQL
             (S.SQL
                (S.CON (false, sqlcon, (sqlconleft, sqlconright)),
                 (U_SQLleft, sqlconright))))
        | U_SQL sqlkwexp
          (A.EXPSQL
             (S.SQL
                (S.EXP
                   (S.KWEXP (false, sqlkwexp, (sqlkwexpleft, sqlkwexpright))),
                 (U_SQLleft, sqlkwexpright))))
        | FN pat DARROW sql
          (A.EXPFN ([(pat, sql, (patleft, sqlright))], (FNleft, sqlright)))

sqlparen
        : LPAREN sqlsteps RPAREN
          (S.SQLPAREN
             (S.SEQ (sqlsteps, (sqlstepsleft, sqlstepsright)),
              (LPARENleft, RPARENright)))
        | LPAREN sql_opt sqlcon RPAREN
          (S.SQLPAREN
             (S.CON (sql_opt, sqlcon, (sql_optleft, sqlconright)),
              (LPARENleft, RPARENright)))
        | LPAREN sqlexp RPAREN
          (S.EXP (S.PAREN (sqlexp, (LPARENleft, RPARENright))))
        | LPAREN PERIODS LPAREN expOrSQL RPAREN RPAREN
          (S.SQLPAREN
             (S.SEQ
                ([S.STEP_EMBED (expOrSQL, (PERIODSleft, RPAREN1right))],
                 (PERIODSleft, RPAREN1right)),
              (LPARENleft, RPAREN2right)))

sqlstep
        : sql_opt sqlcon
          (S.STEP (sql_opt, sqlcon, (sql_optleft, sqlconright)))
        | PERIODS LPAREN expOrSQL RPAREN
          (S.STEP_EMBED (expOrSQL, (PERIODSleft, RPARENright)))

sqlsteps
        : sqlstep SEMICOLON sqlstep
          ([sqlstep1, sqlstep2])
        | sqlstep SEMICOLON sqlsteps
          (sqlstep :: sqlsteps)

sql_opt
        : (* none *)
          (false)
        | U_SQL
          (true)

sqlcon
        : sqlquery
          (S.QRY sqlquery)
        | sqlSelect
          (S.SEL sqlSelect)
        | sqlFrom
          (S.FRM sqlFrom)
        | sqlWhere
          (S.WHR sqlWhere)
        | sqlOrderby
          (S.ORD sqlOrderby)
        | sqlOffset
          (S.OFF sqlOffset)
        | sqlLimit
          (S.LMT sqlLimit)
        | sqlInsert
          (sqlInsert)
        | sqlUpdate
          (sqlUpdate)
        | sqlDelete
          (sqlDelete)
        | BEGIN
          (S.BEGIN (BEGINleft, BEGINright))
        | COMMIT
          (S.COMMIT (COMMITleft, COMMITright))
        | ROLLBACK
          (S.ROLLBACK (ROLLBACKleft, ROLLBACKright))

sqlSelect
        : SELECT sqldistinct sqlSelectList
          (S.SELECT
             (sqldistinct,
              (sqlSelectList, (sqlSelectListleft, sqlSelectListright)),
              (SELECTleft, sqlSelectListright)))

sqlSelectOrExp
        : SELECT PERIODS LPAREN expOrSQL RPAREN
          (S.SELECT_EMBED (expOrSQL, (SELECTleft, expOrSQLright)))
        | sqlSelect
          (sqlSelect)

sqlquery
        : sqlSelectOrExp
          sqlFrom
          sqlWhereOpt
          sqlGroupbyOpt
          sqlOrderbyOpt
          sqlOffsetOrLimitOpt
          (let
             val right = sqlFromright
             val right = case sqlWhereOpt of
                           NONE => right
                         | SOME _ => sqlWhereOptright
             val right = case sqlGroupbyOpt of
                           NONE => right
                         | SOME _ => sqlGroupbyOptright
             val right = case sqlOrderbyOpt of
                           NONE => right
                         | SOME _ => sqlOrderbyOptright
             val right = case sqlOffsetOrLimitOpt of
                           NONE => right
                         | SOME _ => sqlOffsetOrLimitOptright
           in
             S.QUERY (sqlSelectOrExp,
                      sqlFrom,
                      sqlWhereOpt,
                      sqlGroupbyOpt,
                      sqlOrderbyOpt,
                      sqlOffsetOrLimitOpt,
                      (sqlSelectOrExpleft, right))
           end)
        | SELECT PERIODS LPAREN expOrSQL RPAREN
          (S.QUERY_EMBED (expOrSQL, (SELECTleft, expOrSQLright)))

sqlFrom
        : FROM sqljoins
          (S.FROM (sqljoins, (FROMleft, sqljoinsright)))
        | FROM PERIODS LPAREN expOrSQL RPAREN
          (S.FROM_EMBED (expOrSQL, (FROMleft, expOrSQLright)))

sqlWhere
        : WHERE sqlexp_noAND
          (S.WHERE (sqlexp_noAND, (WHEREleft, sqlexp_noANDright)))
        | WHERE PERIODS LPAREN expOrSQL RPAREN
          (S.WHERE_EMBED (expOrSQL, (WHEREleft, expOrSQLright)))

sqlWhereOpt
        : (* none *)
          (NONE)
        | sqlWhere
          (SOME sqlWhere)

sqlGroupbyOpt
        : (* none *)
          (NONE)
        | GROUP BY sqlexps_noAND
          (SOME
             (S.GROUPBY
                ((sqlexps_noAND, (GROUPleft, sqlexps_noANDright)),
                 NONE,
                 (GROUPleft, sqlexps_noANDright))))
        | GROUP BY sqlexps_noAND HAVING sqlexp_noAND
          (SOME
             (S.GROUPBY
                ((sqlexps_noAND, (GROUPleft, sqlexps_noANDright)),
                 SOME (sqlexp_noAND, (HAVINGleft, sqlexp_noANDright)),
                 (GROUPleft, sqlexp_noANDright))))

sqlOrderby
        : ORDER BY sqlOrderKeys
          (S.ORDERBY (sqlOrderKeys, (ORDERleft, sqlOrderKeysright)))
        | ORDER BY PERIODS LPAREN expOrSQL RPAREN
          (S.ORDERBY_EMBED (expOrSQL, (ORDERleft, RPARENright)))

sqlOrderbyOpt
        : (* none *)
          (NONE)
        | sqlOrderby
          (SOME sqlOrderby)

sqlLimit
        : LIMIT sqlexp_noAND
          (S.LIMIT
             ((SOME sqlexp_noAND, (LIMITleft, sqlexp_noANDright)),
              NONE,
              (LIMITleft, sqlexp_noANDright)))
        | LIMIT ALL
          (S.LIMIT
             ((NONE, (LIMITleft, ALLright)),
              NONE,
              (LIMITleft, ALLright)))
        | LIMIT sqlexp_noAND OFFSET sqlexp_noAND
          (S.LIMIT
             ((SOME sqlexp_noAND1, (LIMITleft, sqlexp_noAND1right)),
              SOME (sqlexp_noAND2, (OFFSETleft, sqlexp_noAND2right)),
              (LIMITleft, sqlexp_noAND2right)))
        | LIMIT ALL OFFSET sqlexp_noAND
          (S.LIMIT
             ((NONE, (LIMITleft, ALLright)),
              SOME (sqlexp_noAND, (OFFSETleft, sqlexp_noANDright)),
              (LIMITleft, sqlexp_noANDright)))
        | LIMIT PERIODS LPAREN expOrSQL RPAREN
          (S.LIMIT_EMBED (expOrSQL, (LIMITleft, RPARENright)))

sqlOffset
        : OFFSET sqlatexp sqlrows
          (S.OFFSET
             ((sqlatexp, sqlrows, (OFFSETleft, sqlrowsright)),
              NONE,
              (OFFSETleft, sqlrowsright)))
        | OFFSET sqlatexp sqlrows FETCH sqlfirst sqlatexp sqlrows ONLY
          (S.OFFSET
             ((sqlatexp, sqlrows1, (OFFSETleft, sqlrows1right)),
              SOME (sqlfirst, SOME sqlatexp, sqlrows2,
                    (FETCHleft, ONLYright)),
              (OFFSETleft, ONLYright)))
        | OFFSET sqlatexp sqlrows FETCH sqlfirst sqlrows ONLY
          (S.OFFSET
             ((sqlatexp, sqlrows1, (OFFSETleft, sqlrows1right)),
              SOME (sqlfirst, NONE, sqlrows, (FETCHleft, ONLYright)),
              (OFFSETleft, ONLYright)))
        | OFFSET PERIODS LPAREN expOrSQL RPAREN
          (S.OFFSET_EMBED (expOrSQL, (OFFSETleft, RPARENright)))

sqlOffsetOrLimitOpt
        : (* none *)
          (NONE)
        | sqlLimit
          (SOME (S.LIMIT_CLAUSE sqlLimit))
        | sqlOffset
          (SOME (S.OFFSET_CLAUSE sqlOffset))

sqlfirst
        : FIRST
          (S.FIRST)
        | NEXT
          (S.NEXT)

sqlrows
        : ROW
          (S.ROW)
        | ROWS
          (S.ROWS)

sqldistinct
        : (* none *)
          (NONE)
        | DISTINCT
          (SOME S.DISTINCT)
        | ALL
          (SOME S.ALL)

sqlSelectList
        : sqlSelectRow
          (sqlSelectRow :: nil)
        | sqlSelectRow COMMA sqlSelectList
          (sqlSelectRow :: sqlSelectList)

sqlSelectRow
        : sqlexp_noAND
          (sqlexp_noAND, NONE, (sqlexp_noANDleft, sqlexp_noANDright))
        | sqlexp_noAND AS lab
          (sqlexp_noAND, SOME lab, (sqlexp_noANDleft, labright))

sqlOrderKeys
        : sqlOrderKey
          (sqlOrderKey :: nil)
        | sqlOrderKey COMMA sqlOrderKeys
          (sqlOrderKey :: sqlOrderKeys)

sqlOrderKey
        : sqlexp_noAND
          (sqlexp_noAND, NONE, (sqlexp_noANDleft, sqlexp_noANDright))
        | sqlexp_noAND ASC
          (sqlexp_noAND, SOME S.ASC, (sqlexp_noANDleft, ASCright))
        | sqlexp_noAND DESC
          (sqlexp_noAND, SOME S.DESC, (sqlexp_noANDleft, DESCright))

sqljoins
        : sqljoin
          (sqljoin :: nil)
        | sqljoin COMMA sqljoins
          (sqljoin :: sqljoins)

sqljoin
        : sqltableAs
          (sqltableAs)
        | sqljoin JOIN sqltableAs ON sqlexp_noAND
          (S.TABLE_INNER_JOIN
             (sqljoin,
              false,
              sqltableAs,
              sqlexp_noAND,
              (sqljoinleft, sqlexp_noANDright)))
        | sqljoin INNER JOIN sqltableAs ON sqlexp_noAND
          (S.TABLE_INNER_JOIN
             (sqljoin,
              true,
              sqltableAs,
              sqlexp_noAND,
              (sqljoinleft, sqlexp_noANDright)))
        | sqljoin CROSS JOIN sqltableAs
          (S.TABLE_CROSS_JOIN
             (sqljoin, sqltableAs, (sqljoinleft, sqltableAsright)))
        | sqljoin NATURAL JOIN sqltableAs
          (S.TABLE_NATURAL_JOIN
             (sqljoin, sqltableAs, (sqljoinleft, sqltableAsright)))

sqltableAs
        : sqltableExp AS lab
          (S.TABLE_AS (sqltableExp, lab, (sqltableExpleft, labright)))
        | sqltableExp
          (sqltableExp)

sqltableExp
        : sqltable
          (S.TABLE sqltable)
        | LPAREN sqljoin RPAREN
          (S.TABLE_PAREN (sqljoin, (LPARENleft, RPARENright)))
        | LPAREN sql_opt sqlquery RPAREN
          (S.TABLE_SUBQUERY (sql_opt, sqlquery, (LPARENleft, RPARENright)))

sqltable
        : HASH id PERIOD lab
          (id, lab, (HASHleft, labright))

sqlInsert
        : INSERT INTO sqltable LPAREN sqlInsertLabels RPAREN
          sqlInsertValues
          (S.INSERT_LABELED
             (sqltable,
              (sqlInsertLabels, (LPARENleft, RPARENright)),
              sqlInsertValues,
              (INSERTleft, sqlInsertValuesright)))
        | INSERT INTO sqltable sqlquery
          (S.INSERT_NOLABEL
             (sqltable,
              sqlquery,
              (INSERTleft, sqlqueryright)))

sqlInsertLabels
        : lab
          (lab :: nil)
        | lab COMMA sqlInsertLabels
          (lab :: sqlInsertLabels)

sqlInsertValues
        : VALUES sqlInsertRows
          (S.INSERT_VALUES (sqlInsertRows, (VALUESleft, sqlInsertRowsright)))
        | VALUES op_opt longid
          (S.INSERT_VAR
             ((op_opt, longid, (op_optleft, longidright)),
              (VALUESleft, longidright)))
        | sqlquery
          (S.INSERT_SELECT sqlquery)

sqlInsertRow
        : LPAREN sqlInsertRowValues RPAREN
          (sqlInsertRowValues, (LPARENleft, RPARENright))

sqlInsertRows
        : sqlInsertRow
          (sqlInsertRow :: nil)
        | sqlInsertRow COMMA sqlInsertRows
          (sqlInsertRow :: sqlInsertRows)

sqlInsertRowValues
        : sqlInsertRowValue
          (sqlInsertRowValue :: nil)
        | sqlInsertRowValue COMMA sqlInsertRowValues
          (sqlInsertRowValue :: sqlInsertRowValues)

sqlInsertRowValue
        : sqlexp
          (S.VALUE sqlexp)
        | DEFAULT
          (S.DEFAULT (DEFAULTleft, DEFAULTright))

sqlUpdate
        : UPDATE sqltable SET sqlsetrows sqlWhereOpt
          (let
             val right = sqlsetrowsright
             val right = case sqlWhereOpt of
                           NONE => right
                         | SOME _ => sqlWhereOptright
           in
             S.UPDATE (sqltable,
                       (sqlsetrows, (SETleft, sqlsetrowsright)),
                       sqlWhereOpt,
                       (UPDATEleft, right))
           end)

sqlsetrow
        : lab EQ sqlexp_noAND
          (lab, sqlexp_noAND, (lableft, sqlexp_noANDright))

sqlsetrows
        : sqlsetrow
          ([sqlsetrow])
        | sqlsetrow COMMA sqlsetrows
          (sqlsetrow :: sqlsetrows)

sqlDelete
        : DELETE FROM sqltable sqlWhereOpt
          (let
             val right = sqltableright
             val right = case sqlWhereOpt of
                           NONE => right
                         | SOME _ => sqlWhereOptright
           in
             S.DELETE (sqltable, sqlWhereOpt, (DELETEleft, right))
           end)

sqlatexp
        : constant
          (S.CONST (constant, (constantleft, constantright)))
        | NULL
          (S.NULL (NULLleft, NULLright))
        | TRUE
          (S.TRUE (TRUEleft, TRUEright))
        | FALSE
          (S.FALSE (FALSEleft, FALSEright))
        | LPAREN RPAREN
          (S.CONST (A.UNITCONST, (LPARENleft, RPARENright)))
        | OP longid
          (S.ID (true, longid, (OPleft, longidright)))
        | id_noSQL
          (S.ID (false,
                 ([id_noSQL], (id_noSQLleft, id_noSQLright)),
                 (id_noSQLleft, id_noSQLright)))
        | HASH lab PERIOD lab
          (S.COLUMN2 (lab1, lab2, (HASHleft, lab2right)))
        | HASH_STRING PERIOD lab
          (S.COLUMN2
             ((RecordLabel.fromString HASH_STRING,
               (HASH_STRINGleft, HASH_STRINGright)),
              lab,
              (HASH_STRINGleft, labright)))
        | HASH PERIOD lab
          (S.COLUMN1 (lab, (HASHleft, labright)))
        | sql_opt sqlkwexp
          (S.KWEXP (sql_opt, sqlkwexp, (sql_optleft, sqlkwexpright)))
        | LPAREN sqlexp RPAREN
          (S.PAREN (sqlexp, (LPARENleft, RPARENright)))
        | LPAREN sql_opt sqlquery RPAREN
          (S.EXP_SUBQUERY (sql_opt, sqlquery, (sql_optleft, sqlqueryright)))
        | LPAREN PERIODS expOrSQL RPAREN
          (S.EXP_EMBED (expOrSQL, (LPARENleft, RPARENright)))
        | LPAREN sqlexp COMMA sqlexps RPAREN
          (S.TUPLE (sqlexp :: sqlexps, (LPARENleft, RPARENright)))

sqlkwexp
        : EXISTS LPAREN sql_opt sqlquery RPAREN
          (S.EXISTS (sqlquery, (EXISTSleft, RPARENright)))

sqlappexp
        : sqlatexp
          (NIL ::> sqlatexp)
        | sqlappexp IS NULL
          (NIL ::> S.OP1 (S.IS_NULL,
                          S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                          (sqlappexpleft, NULLright)))
        | sqlappexp IS NOT NULL
          (NIL ::> S.OP1 (S.IS_NOT_NULL,
                          S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                          (sqlappexpleft, NULLright)))
        | sqlappexp IS TRUE
          (NIL ::> S.OP1 (S.IS_TRUE,
                          S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                          (sqlappexpleft, TRUEright)))
        | sqlappexp IS NOT TRUE
          (NIL ::> S.OP1 (S.IS_NOT_TRUE,
                          S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                          (sqlappexpleft, TRUEright)))
        | sqlappexp IS FALSE
          (NIL ::> S.OP1 (S.IS_FALSE,
                          S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                          (sqlappexpleft, FALSEright)))
        | sqlappexp IS NOT FALSE
          (NIL ::> S.OP1 (S.IS_NOT_FALSE,
                          S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                          (sqlappexpleft, FALSEright)))
        | sqlappexp IS UNKNOWN
          (NIL ::> S.OP1 (S.IS_UNKNOWN,
                          S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                          (sqlappexpleft, UNKNOWNright)))
        | sqlappexp IS NOT UNKNOWN
          (NIL ::> S.OP1 (S.IS_NOT_UNKNOWN,
                          S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                          (sqlappexpleft, UNKNOWNright)))
        | sqlappexp sqlatexp
          (sqlappexp ::> sqlatexp)

sqlnotexp
        : sqlappexp
          (S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)))
        | NOT sqlappexp
          (S.OP1 (S.NOT,
                  S_APP (sqlappexp, (sqlappexpleft, sqlappexpright)),
                  (NOTleft, sqlappexpright)))

sqlconjexp
        : sqlnotexp
          (sqlnotexp)
        | sqlconjexp AND sqlnotexp
          (S.OP2 (S.AND, sqlconjexp, sqlnotexp,
                  (sqlconjexpleft, sqlnotexpright)))

sqlexp
        : sqlconjexp
          (sqlconjexp)
        | sqlexp OR sqlconjexp
          (S.OP2 (S.OR, sqlexp, sqlconjexp,
                  (sqlexpleft, sqlconjexpright)))

sqlexp_noAND
        : sqlnotexp
          (sqlnotexp)
        | sqlexp_noAND OR sqlnotexp
          (S.OP2 (S.OR, sqlexp_noAND, sqlnotexp,
                  (sqlexp_noANDleft, sqlnotexpright)))

sqlexps
        : sqlexp
          (sqlexp :: nil)
        | sqlexp COMMA sqlexps
          (sqlexp :: sqlexps)

sqlexps_noAND
        : sqlexp_noAND
          (sqlexp_noAND :: nil)
        | sqlexp_noAND COMMA sqlexps_noAND
          (sqlexp_noAND :: sqlexps_noAND)

sqlapppat_noID
        : atpat_noID_noPAREN
          (NIL ::> atpat_noID_noPAREN)
        | LPAREN RPAREN
          (NIL ::> A.PATCONST (A.UNITCONST, (LPARENleft, RPARENright)))
        | id_noEQSQL atpat
          (NIL
           ::> PATID (id_noEQSQL, (id_noEQSQLleft, id_noEQSQLright))
           ::> atpat)
        | OP id_noEQ atpat
          (NIL
           ::> OP_PATID (id_noEQ, OPleft, (id_noEQleft, id_noEQright))
           ::> atpat)
        | sqlapppat_noID atpat
          (sqlapppat_noID ::> atpat)

sqlpat
        : sqlapppat_noID
          (PATAPP (sqlapppat_noID, (sqlapppat_noIDleft, sqlapppat_noIDright)))
        | sqlapppat_noID COLON ty
          (A.PATTYPED
             (PATAPP (sqlapppat_noID,
                      (sqlapppat_noIDleft, sqlapppat_noIDright)),
              ty,
              (sqlapppat_noIDleft, tyright)))
        | id_noEQ COLON ty
          (A.PATTYPED
             (PATID (id_noEQ, (id_noEQleft, id_noEQright)),
              ty,
              (id_noEQleft, tyright)))
        | OP id_noEQ COLON ty
          (A.PATTYPED
             (OP_PATID (id_noEQ, OPleft, (id_noEQleft, id_noEQright)),
              ty,
              (OPleft, tyright)))
        | id_noEQSQL
          (PATID (id_noEQSQL, (id_noEQSQLleft, id_noEQSQLright)))
        | OP id_noEQ
          (OP_PATID (id_noEQ, OPleft, (id_noEQleft, id_noEQright)))
        | aspat
          (aspat)

(*************************** dec ********************************)

decs
        : (* none *)
          (nil)
        | SEMICOLON decs
          (A.DECSEMICOLON (SEMICOLONleft, SEMICOLONright) :: decs)
        | dec decs
          (dec :: decs)
        | LOCAL decs IN decs END decs
          (A.DECLOCAL (decs1, decs2, (LOCALleft, ENDright)) :: decs3)

(*
  Ohori: VAL, VAL REC and FUN now take kinded_tyvarseq
  instead of tyvar_seq.
  2007/11/11
*)

dec
        : VAL valbind
          (A.DECVAL ((nil, Loc.noloc), valbind, (VALleft, valbindright)))
        | VAL kinded_tyvarseq valbind
          (A.DECVAL (kinded_tyvarseq, valbind, (VALleft, valbindright)))
        | VAL U_POLYREC pvalbind
          (A.DECPOLYREC (pvalbind, (VALleft, pvalbindright)))
        | FUN fvalbind
          (A.DECFUN ((nil, Loc.noloc), fvalbind, (FUNleft, fvalbindright)))
        | FUN kinded_tyvarseq fvalbind
          (A.DECFUN (kinded_tyvarseq, fvalbind, (FUNleft, fvalbindright)))
        | TYPE typbind
          (A.DECTYPE (typbind, (TYPEleft, typbindright)))
        | DATATYPE datbind
          (A.DECDATATYPE (datbind, nil, (DATATYPEleft, datbindright)))
        | DATATYPE datbind WITHTYPE typbind
          (A.DECDATATYPE (datbind, typbind, (DATATYPEleft, typbindright)))
        | DATATYPE id_noEQSTAR EQ DATATYPE longid
          (A.DECDATATYPEREP (id_noEQSTAR, longid, (DATATYPEleft, longidright)))
        | ABSTYPE datbind WITH decs END
          (A.DECABSTYPE (datbind, nil, decs, (ABSTYPEleft, ENDright)))
        | ABSTYPE datbind WITHTYPE typbind WITH decs END
          (A.DECABSTYPE (datbind, typbind, decs, (ABSTYPEleft, ENDright)))
        | EXCEPTION exbind
          (A.DECEXCEPTION (exbind, (EXCEPTIONleft, exbindright)))
        | OPEN longstrids
          (A.DECOPEN (longstrids, (OPENleft, longstridsright)))
        | INFIX prec vids
          (A.DECINFIX (prec, vids, (INFIXleft, vidsright)))
        | INFIXR prec vids
          (A.DECINFIXR (prec, vids, (INFIXRleft, vidsright)))
        | NONFIX vids
          (A.DECNONFIX (vids, (NONFIXleft, vidsright)))

prec
        : int
          (SOME int)
        | (* none *)
          (NONE)

typbind_1
        : id_noEQSTAR EQ ty
          ((nil, Loc.noloc), id_noEQSTAR, ty, (id_noEQSTARleft, tyright))
        | tyvarseq id_noEQSTAR EQ ty
          (tyvarseq, id_noEQSTAR, ty, (tyvarseqleft, tyright))

typbind
        : typbind_1
          ([typbind_1])
        | typbind_1 AND typbind
          (typbind_1 :: typbind)

datbind_1
        : id_noEQSTAR EQ conbind
          ((nil, Loc.noloc),
           id_noEQSTAR,
           conbind, (id_noEQSTARleft, conbindright))
        | tyvarseq id_noEQSTAR EQ conbind
          (tyvarseq, id_noEQSTAR, conbind, (tyvarseqleft, conbindright))

datbind
        : datbind_1
          ([datbind_1])
        | datbind_1 AND datbind
          (datbind_1 :: datbind)

op_opt
        : (* none *)
          (false)
        | OP
          (true)

conbind_1
        : op_opt id_noEQ
          ((op_opt, id_noEQ, (op_optleft, id_noEQright)),
           NONE,
           (op_optleft, id_noEQright))
        | op_opt id_noEQ OF ty
          ((op_opt, id_noEQ, (op_optleft, id_noEQright)),
           SOME ty,
           (op_optleft, tyright))

conbind
        : conbind_1
          ([conbind_1])
        | conbind_1 BAR conbind
          (conbind_1 :: conbind)

exbind_1
        : op_opt id_noEQ
          (A.EXBIND
             ((op_opt, id_noEQ, (op_optleft, id_noEQright)),
              NONE,
              (op_optleft, id_noEQright)))
        | op_opt id_noEQ OF ty
          (A.EXBIND
             ((op_opt, id_noEQ, (op_optleft, id_noEQright)),
              SOME ty,
              (op_optleft, tyright)))
        | op_opt id_noEQ EQ op_opt longid
          (A.EXBINDREP
             ((op_opt1, id_noEQ, (op_opt1left, id_noEQright)),
              (op_opt2, longid, (op_opt2left, longidright)),
              (op_opt1left, longidright)))

exbind
        : exbind_1
          ([exbind_1])
        | exbind_1 AND exbind
          (exbind_1 :: exbind)

tyvar
        : TYVAR
          (false, (Symbol.fromString TYVAR, (TYVARleft, TYVARright)))
        | EQTYVAR
          (true, (Symbol.fromString EQTYVAR, (EQTYVARleft, EQTYVARright)))

free_tyvar
        : FREE_TYVAR
          (false,
           (Symbol.fromString FREE_TYVAR, (FREE_TYVARleft, FREE_TYVARright)))
        | FREE_EQTYVAR
          (true,
           (Symbol.fromString FREE_EQTYVAR,
            (FREE_EQTYVARleft, FREE_EQTYVARright)))

tyvarseq
        : tyvar
          ([tyvar], (tyvarleft, tyvarright))
        | LPAREN tyvar RPAREN (* not in the definition *)
          ([tyvar], (LPARENleft, RPARENright))
        | LPAREN tyvars_comma RPAREN
          (tyvars_comma, (LPARENleft, RPARENright))

tyvars_comma
        : tyvar COMMA tyvar
          ([tyvar1, tyvar2])
        | tyvar COMMA tyvars_comma
          (tyvar :: tyvars_comma)

valbind_1
        : pat EQ expOrSQL
          (A.VALBIND (pat, expOrSQL, (patleft, expOrSQLright)))

valbind
        : valbind_1
          ([valbind_1])
        | valbind_1 AND valbind
          (valbind_1 :: valbind)
        | REC valbind
          ([A.VALREC (valbind, (RECleft, valbindright))])

pvalbind_1
        : id_noEQ COLON poly_ty EQ expOrSQL
          ((id_noEQ, poly_ty, expOrSQL, (id_noEQleft, expOrSQLright)))

pvalbind
        : pvalbind_1
          ([pvalbind_1])
        | pvalbind_1 AND pvalbind
          (pvalbind_1 :: pvalbind)

frule
        : apppat EQ expOrSQL
          (Snoc.toList apppat, NONE, expOrSQL, (apppatleft, expOrSQLright))
        | apppat_COLON_ty EQ expOrSQL
          (Snoc.toList (#1 apppat_COLON_ty),
           SOME (#3 apppat_COLON_ty),
           expOrSQL,
           (apppat_COLON_tyleft, expOrSQLright))

fvalbind_1
        : frule
          ([frule], (fruleleft, fruleright))
        | frule BAR fvalbind_1
          (frule :: #1 fvalbind_1, (fruleleft, fvalbind_1right))

fvalbind
        : fvalbind_1
          ([fvalbind_1])
        | fvalbind_1 AND fvalbind
          (fvalbind_1 :: fvalbind)

(*****************  pattern ***********************)

atpat_noID_noPAREN
        : UNDERBAR
          (A.PATWILD (UNDERBARleft, UNDERBARright))
        | constant
          (A.PATCONST (constant, (constantleft, constantright)))
        | longid_noID
          (A.PATID (false, longid_noID, (longid_noIDleft, longid_noIDright)))
        | OP longid_noID
          (A.PATID (true, longid_noID, (OPleft, longid_noIDright)))
        | LBRACE RBRACE
          (A.PATRECORD (nil, false, (LBRACEleft, RBRACEright)))
        | LBRACE patrow RBRACE
          (A.PATRECORD (#1 patrow, #2 patrow, (LBRACEleft, RBRACEright)))
        | LBRACKET RBRACKET
          (A.PATLIST (nil, (LBRACKETleft, RBRACKETright)))
        | LBRACKET pat RBRACKET
          (A.PATLIST ([pat], (LBRACKETleft, RBRACKETright)))
        | LBRACKET pats_comma RBRACKET
          (A.PATLIST (Snoc.toList pats_comma, (LBRACKETleft, RBRACKETright)))

atpat_noID
        : atpat_noID_noPAREN
          (atpat_noID_noPAREN)
        | LPAREN RPAREN
          (A.PATCONST (A.UNITCONST, (LPARENleft, RPARENright)))
        | LPAREN pats_comma RPAREN
          (A.PATTUPLE (Snoc.toList pats_comma, (LPARENleft, RPARENright)))
        | LPAREN pat RPAREN
          (A.PATPAREN (pat, (LPARENleft, RPARENright)))

atpat
        : atpat_noID
          (atpat_noID)
        | id_noEQ
          (PATID (id_noEQ, (id_noEQleft, id_noEQright)))
        | OP id_noEQ
          (OP_PATID (id_noEQ, OPleft, (id_noEQleft, id_noEQright)))

apppat_noID
        : atpat_noID
          (NIL ::> atpat_noID)
        | id_noEQ atpat
          (NIL
           ::> PATID (id_noEQ, (id_noEQleft, id_noEQright))
           ::> atpat)
        | OP id_noEQ atpat
          (NIL
           ::> OP_PATID (id_noEQ, OPleft, (id_noEQleft, id_noEQright))
           ::> atpat)
        | apppat_noID atpat
          (apppat_noID ::> atpat)

apppat
        : apppat_noID
          (apppat_noID)
        | id_noEQ
          (NIL ::> PATID (id_noEQ, (id_noEQleft, id_noEQright)))
        | OP id_noEQ
          (NIL ::> OP_PATID (id_noEQ, OPleft, (id_noEQleft, id_noEQright)))

apppat_COLON_ty
        : apppat_noID COLON ty
          (apppat_noID, (apppat_noIDleft, apppat_noIDright), ty)
        | id_noEQ COLON ty
          (NIL ::> PATID (id_noEQ, (id_noEQleft, id_noEQright)),
           (id_noEQleft, id_noEQright),
           ty)
        | OP id_noEQ COLON ty
          (NIL ::> OP_PATID (id_noEQ, OPleft, (id_noEQleft, id_noEQright)),
           (OPleft, id_noEQright),
           ty)

aspat
        : id_noEQ colon_ty_opt AS pat
          (A.PATAS
             ((false, id_noEQ, (id_noEQleft, id_noEQright)),
              colon_ty_opt,
              pat,
              (id_noEQleft, patright)))
        | OP id_noEQ colon_ty_opt AS pat
          (A.PATAS
             ((true, id_noEQ, (OPleft, id_noEQright)),
              colon_ty_opt,
              pat,
              (OPleft, patright)))

pat
        : apppat
          (PATAPP (apppat, (apppatleft, apppatright)))
        | apppat_COLON_ty
          (A.PATTYPED
             (PATAPP (#1 apppat_COLON_ty, #2 apppat_COLON_ty),
              #3 apppat_COLON_ty,
              (apppat_COLON_tyleft, apppat_COLON_tyright)))
        | aspat
          (aspat)

colon_ty_opt
        : COLON ty
          (SOME ty)
        | (* none *)
          (NONE)

patrow_1
        : lab EQ pat
          (A.PATROW (lab, pat, (lableft, patright)))
        | id_noEQ
          (A.PATROWVAR (id_noEQ, NONE, NONE, (id_noEQleft, id_noEQright)))
        | id_noEQ COLON ty
          (A.PATROWVAR (id_noEQ, SOME ty, NONE, (id_noEQleft, tyright)))
        | id_noEQ colon_ty_opt AS pat
          (A.PATROWVAR
             (id_noEQ, colon_ty_opt, SOME pat, (id_noEQleft, patright)))

patrow
        : patrow_1
          ([patrow_1], false)
        | patrow_1 COMMA patrow
          (patrow_1 :: #1 patrow, #2 patrow)
        | PERIODS
          (nil, true)

pats_comma
        : pat COMMA pat
          (NIL ::> pat1 ::> pat2)
        | pats_comma COMMA pat
          (pats_comma ::> pat)

(****************  types *********************)

tyrow_1
        : lab COLON ty
          (lab, ty, (lableft, tyright))

tyrow
        : tyrow_1
          ([tyrow_1])
        | tyrow_1 COMMA tyrow
          (tyrow_1 :: tyrow)

tyrow_flex
        : tyrow_1
          ([tyrow_1], false)
        | tyrow_1 COMMA tyrow_flex
          (tyrow_1 :: #1 tyrow_flex, #2 tyrow_flex)
        | PERIODS (* not in the definition *)
          (nil, true)

atty
        : UNDERBAR
          (A.TYWILD (UNDERBARleft, UNDERBARright))
        | tyvar
          (A.TYVAR tyvar)
        | kinded_free_tyvar
          (A.TYVAR_FREE kinded_free_tyvar)
        | LBRACE tyrow_flex RBRACE
          (A.TYRECORD (#1 tyrow_flex, #2 tyrow_flex, (LBRACEleft, RBRACEright)))
        | LBRACE RBRACE
          (A.TYRECORD (nil, false, (LBRACEleft, RBRACEright)))
        | LPAREN ty RPAREN
          (A.TYPAREN (ty, (LPARENleft, RPARENright)))

appty
        : atty
          (atty)
        | tyseq longtycon_noEQ
          (A.TYCON (tyseq, longtycon_noEQ, (tyseqleft, longtycon_noEQright)))

tyseq
        : appty
          ([appty], (apptyleft, apptyright))
        | LPAREN tys_comma RPAREN
          (tys_comma, (LPARENleft, RPARENright))
        | (* none *)
          (nil, Loc.noloc)

tys_comma
        : ty COMMA ty
          ([ty1, ty2])
        | ty COMMA tys_comma
          (ty :: tys_comma)

tytuple
        : appty ASTERISK tytuple
          (appty :: tytuple)
        | appty ASTERISK appty
          ([appty1, appty2])

tuplety
        : appty
          (appty)
        | tytuple
          (A.TYTUPLE (tytuple, (tytupleleft, tytupleright)))

ty
        : tuplety
          (tuplety)
        | tuplety ARROW ty
          (A.TYFUN (tuplety, ty, (tupletyleft, tyright)))

(*
 Ohori; poly_ty and the related definitions are added for rank1 type
  specification
 2007/11/11
*)
poly_tyrow_1
        : lab COLON poly_ty
          (lab, poly_ty, (lableft, poly_tyright))

poly_tyrow
        : poly_tyrow_1
          ([poly_tyrow_1])
        | poly_tyrow_1 COMMA poly_tyrow
          (poly_tyrow_1 :: poly_tyrow)
        | poly_tyrow_1 COMMA tyrow
          (poly_tyrow_1 :: tyrow)
        | tyrow_1 COMMA poly_tyrow
          (tyrow_1 :: poly_tyrow)

poly_ty1
        : LBRACE poly_tyrow RBRACE
          (A.TYRECORD (poly_tyrow, false, (LBRACEleft, RBRACEright)))
        | LPAREN poly_ty RPAREN
          (A.TYPAREN (poly_ty, (LPARENleft, RPARENright)))
        | LBRACKET kinded_tyvars PERIOD ty RBRACKET
          (A.TYPOLY (kinded_tyvars, ty, (LBRACKETleft, RBRACKETright)))
        | LBRACKET kinded_tyvars PERIOD poly_ty RBRACKET
          (A.TYPOLY (kinded_tyvars, poly_ty, (LBRACKETleft, RBRACKETright)))

poly_tytuple
        : poly_ty1 ASTERISK poly_tytuple
          (poly_ty1 :: poly_tytuple)
        | poly_ty1 ASTERISK tytuple
          (poly_ty1 :: tytuple)
        | poly_ty1 ASTERISK poly_ty1
          ([poly_ty11, poly_ty12])
        | poly_ty1 ASTERISK appty
          ([poly_ty1, appty])
        | appty ASTERISK poly_tytuple
          (appty :: poly_tytuple)
        | appty ASTERISK poly_ty1
          ([appty, poly_ty1])

poly_ty
        : tuplety ARROW poly_ty
          (A.TYFUN (tuplety, poly_ty, (tupletyleft, poly_tyright)))
        | poly_tytuple
          (A.TYTUPLE (poly_tytuple, (poly_tytupleleft, poly_tytupleright)))
        | poly_ty1
          (poly_ty1)

kind
        : HASH LBRACE RBRACE
          (nil, SOME nil)
        | HASH LBRACE tyrow RBRACE
          (nil, SOME tyrow)
        | HASH alphabetic_id
          ([alphabetic_id], NONE)
        | HASH alphabetic_id kind
          ((alphabetic_id :: #1 kind), #2 kind)

kinded_tyvar
        : tyvar
          (tyvar, A.UNIV (nil, Loc.noloc), (tyvarleft, tyvarright))
        | tyvar kind
          (tyvar,
           case kind of
             (properties, NONE) =>
             A.UNIV (properties, (kindleft, kindright))
           | (properties, SOME tyrow) =>
             A.REC (properties, tyrow, (kindleft, kindright)),
           (tyvarleft, kindright))

kinded_free_tyvar
        : free_tyvar
          (free_tyvar,
           A.UNIV (nil, Loc.noloc),
           (free_tyvarleft, free_tyvarright))
        | free_tyvar kind
          (free_tyvar,
           case kind of
             (properties, NONE) =>
             A.UNIV (properties, (kindleft, kindright))
           | (properties, SOME tyrow) =>
             A.REC (properties, tyrow, (kindleft, kindright)),
           (free_tyvarleft, kindright))

kinded_tyvarseq
        : kinded_tyvar
          ([kinded_tyvar], (kinded_tyvarleft, kinded_tyvarright))
        | LPAREN kinded_tyvar RPAREN (* not in the definition *)
          ([kinded_tyvar], (LPARENleft, RPARENright))
        | LPAREN kinded_tyvars_comma RPAREN
          (kinded_tyvars_comma, (LPARENleft, RPARENright))

kinded_tyvars_comma
        : kinded_tyvar COMMA kinded_tyvar
          ([kinded_tyvar1, kinded_tyvar2])
        | kinded_tyvar COMMA kinded_tyvars_comma
          (kinded_tyvar :: kinded_tyvars_comma)

kinded_tyvars
        : kinded_tyvar
          ([kinded_tyvar])
        | kinded_tyvar COMMA kinded_tyvars
          (kinded_tyvar :: kinded_tyvars)

(*********** foreign function interface *************)

ffityrow_1
        : lab COLON ffity
          (lab, ffity, (lableft, ffityright))

ffityrow
        : ffityrow_1
          ([ffityrow_1])
        | ffityrow_1 COMMA ffityrow
          (ffityrow_1 :: ffityrow)

ffitys
        : ffity COMMA ffity
          ([ffity1, ffity2])
        | ffity COMMA ffitys
          (ffity :: ffitys)

ffitys_opt
        : (* none *)
          (nil)
        | ffity
          ([ffity])
        | ffity COMMA ffitys_opt
          (ffity :: ffitys_opt)

ffitys_COMMA
        : ffity COMMA ffity COMMA
          ([ffity1, ffity2])
        | ffity COMMA ffitys_COMMA
          (ffity :: ffitys_COMMA)

ffityseq
        : (* none *)
          (nil, Loc.noloc)
        | ffiatty
          ([ffiatty], (ffiattyleft, ffiattyright))
        | LPAREN ffitys RPAREN
          (ffitys, (LPARENleft, RPARENright))

ffiatty
        : LPAREN ffity RPAREN
          (A.FFITYPAREN (ffity, (LPARENleft, RPARENright)))
        | tyvar
          (A.FFITYVAR tyvar)
        | ffityseq longtycon
          (A.FFITYCON (ffityseq, longtycon, (ffityseqleft, longtyconright)))
        | LBRACE ffityrow RBRACE
          (A.FFITYRECORD (ffityrow, (LBRACEleft, RBRACEright)))
        | LBRACE RBRACE
          (A.FFITYRECORD (nil, (LBRACEleft, RBRACEright)))

ffitytuple
        : ffiatty ASTERISK ffiatty
          ([ffiatty1, ffiatty2])
        | ffiatty ASTERISK ffitytuple
          (ffiatty :: ffitytuple)

ffituplety
        : ffitytuple
          (A.FFITYTUPLE (ffitytuple, (ffitytupleleft, ffitytupleright)))

ffiarg
        : ffiatty
          ([ffiatty], NONE, (ffiattyleft, ffiattyright))
        | ffituplety
          ([ffituplety], NONE, (ffitupletyleft, ffitupletyright))
        | LPAREN RPAREN
          (nil, NONE, (LPARENleft, RPARENright))
        | LPAREN ffitys RPAREN
          (ffitys, NONE, (LPARENleft, LPARENright))
        | LPAREN ffity COMMA PERIODS LPAREN ffitys_opt RPAREN RPAREN
          ([ffity], SOME ffitys_opt, (LPAREN1left, RPAREN2right))
        | LPAREN ffitys_COMMA PERIODS LPAREN ffitys_opt RPAREN RPAREN
          (ffitys_COMMA, SOME ffitys_opt, (LPAREN1left, RPAREN2right))

ffiret
        : ffity
          ([ffity], (ffityleft, ffityright))
        | LPAREN RPAREN
          (nil, (LPARENleft, RPARENright))
        | LPAREN ffitys RPAREN
          (ffitys, (LPARENleft, RPARENright))

ffifunty
        : ffiarg ARROW ffiret
          (A.FFITYFUN
             ((nil, Loc.noloc), ffiarg, ffiret, (ffiargleft, ffiretright)))
        | ffiattr ffiarg ARROW ffiret
          (A.FFITYFUN
             (ffiattr, ffiarg, ffiret, (ffiattrleft, ffiretright)))

ffiattrs
        : alphabetic_id
          ([alphabetic_id])
        | alphabetic_id COMMA ffiattrs
          (alphabetic_id :: ffiattrs)

ffiattr
        : U_ATTRIBUTE LPAREN LPAREN ffiattrs RPAREN RPAREN
          (ffiattrs, (U_ATTRIBUTEleft, RPAREN2right))

ffity
        : ffiatty
          (ffiatty)
        | ffifunty
          (ffifunty)
        | ffituplety
          (ffituplety)

(**************** structure and signature************)

strexpbasic
        : STRUCT strdecs END
          (A.STRBASIC (strdecs, (STRUCTleft, ENDright)))
        | longstrid
          (A.STRID longstrid)
        | alphabetic_id LPAREN funarg RPAREN
          (A.STRAPP (alphabetic_id, funarg, (alphabetic_idleft, RPARENright)))
        | LET strdecs IN strexp END
          (A.STRLET (strdecs, strexp, (LETleft, ENDright)))

funarg
        : strexp
          (A.FUNARG strexp)
        | strdecs
          (A.FUNARG_DEC strdecs)

strexp
        : strexpbasic
          (strexpbasic)
        | strexp COLON sigexp
          (A.STRCONSTRAINT
             (strexp, A.TRANSPARENT, sigexp, (strexpleft, sigexpright)))
        | strexp OPAQUE sigexp
          (A.STRCONSTRAINT
             (strexp, A.OPAQUE, sigexp, (strexpleft, sigexpright)))

strexp_AND
        : strexpbasic AND
          (strexpbasic, strexpbasicright)
        | strexp COLON sigexp_AND
          (A.STRCONSTRAINT
             (strexp,
              A.TRANSPARENT,
              #1 sigexp_AND,
              (strexpleft, #2 sigexp_AND)),
           #2 sigexp_AND)
        | strexp OPAQUE sigexp_AND
          (A.STRCONSTRAINT
             (strexp, A.OPAQUE, #1 sigexp_AND, (strexpleft, #2 sigexp_AND)),
           #2 sigexp_AND)

strdecs
        : strdec strdecs
          (strdec :: strdecs)
        | SEMICOLON strdecs
          (A.STRSEMICOLON (SEMICOLONleft, SEMICOLONright) :: strdecs)
        | (* none *)
          (nil)

strdec
        : dec
          (A.STRDEC dec)
        | STRUCTURE strbindseq
          (A.STRUCTURE (strbindseq, (STRUCTUREleft, strbindseqright)))
        | LOCAL strdecs IN strdecs END
          (A.STRLOCAL (strdecs1, strdecs2, (LOCALleft, ENDright)))

strbind
        : alphabetic_id EQ strexp
          (alphabetic_id, NONE, strexp, (alphabetic_idleft, strexpright))
        | alphabetic_id COLON sigexp EQ strexp
          (alphabetic_id,
           SOME (A.TRANSPARENT, sigexp, (COLONleft, sigexpright)),
           strexp,
           (alphabetic_idleft, strexpright))
        | alphabetic_id OPAQUE sigexp EQ strexp
          (alphabetic_id,
           SOME (A.OPAQUE, sigexp, (OPAQUEleft, sigexpright)),
           strexp,
           (alphabetic_idleft, strexpright))

strbind_AND
        : alphabetic_id EQ strexp_AND
          ((alphabetic_id,
            NONE,
            #1 strexp_AND,
            (alphabetic_idleft, #2 strexp_AND)),
            #2 strexp_AND)
        | alphabetic_id COLON sigexp EQ strexp_AND
          ((alphabetic_id,
            SOME (A.TRANSPARENT, sigexp, (COLONleft, #2 strexp_AND)),
            #1 strexp_AND,
            (alphabetic_idleft, #2 strexp_AND)),
           #2 strexp_AND)
        | alphabetic_id OPAQUE sigexp EQ strexp_AND
          ((alphabetic_id,
            SOME (A.OPAQUE, sigexp, (OPAQUEleft, #2 strexp_AND)),
            #1 strexp_AND,
            (alphabetic_idleft, #2 strexp_AND)),
           #2 strexp_AND)

strbindseq
        : strbind
          ([strbind])
        | strbind_AND strbindseq
          (#1 strbind_AND :: strbindseq)

sigexpbasic
        : SIG spec END
          (A.SIGBASIC (Snoc.toList spec, (SIGleft, ENDright)))
        | alphabetic_id
          (A.SIGID alphabetic_id)

wheretype
        : longtycon EQ ty
          ((nil, Loc.noloc), longtycon, ty, (longtyconleft, tyright))
        | tyvarseq longtycon EQ ty
          (tyvarseq, longtycon, ty, (tyvarseqleft, tyright))

sigexpwhere
        : sigexp WHERE TYPE wheretype
          (sigexp, NIL ::> wheretype)
        | sigexpwhere AND TYPE wheretype
          (#1 sigexpwhere, #2 sigexpwhere ::> wheretype)

sigexp
        : sigexpbasic
          (sigexpbasic)
        | sigexpwhere
          (A.SIGWHERE
             (#1 sigexpwhere,
              Snoc.toList (#2 sigexpwhere),
              (sigexpwhereleft, sigexpwhereright)))

sigexp_AND
        : sigexpbasic AND
          (sigexpbasic, sigexpbasicright)
        | sigexpwhere AND
          (A.SIGWHERE
             (#1 sigexpwhere,
              Snoc.toList (#2 sigexpwhere),
              (sigexpwhereleft, sigexpwhereright)),
           sigexpwhereright)

sigbind
        : alphabetic_id EQ sigexp
          ([(alphabetic_id, sigexp, (alphabetic_idleft, sigexpright))])
        | alphabetic_id EQ sigexp_AND sigbind
          ((alphabetic_id, #1 sigexp_AND, (alphabetic_idleft, #2 sigexp_AND))
           :: sigbind)

(***********************specifications******************************)

longtycons_eq
        : longtycon EQ longtycon
          ([longtycon1, longtycon2])
        | longtycon EQ longtycons_eq
          (longtycon :: longtycons_eq)

longstrids_eq
        : longstrid EQ longstrid
          ([longstrid1, longstrid2])
        | longstrid EQ longstrids_eq
          (longstrid :: longstrids_eq)

spec
        : (* none *)
          (NIL)
        | spec atomicspec
          (spec ::> atomicspec)
        | spec SHARING TYPE longtycons_eq
          (NIL ::> A.SPECSHARINGTYPE (Snoc.toList spec, longtycons_eq,
                                      (specleft, longtycons_eqright)))
        | spec SHARING longstrids_eq
          (NIL ::> A.SPECSHARING (Snoc.toList spec, longstrids_eq,
                                  (specleft, longstrids_eqright)))

atomicspec
        : VAL valdesc
          (A.SPECVAL (valdesc, (VALleft, valdescright)))
        | TYPE typdesc
          (A.SPECTYPE (typdesc, (TYPEleft, typdescright)))
        | TYPE typbind
          (A.SPECTYPEINC (typbind, (TYPEleft, typbindright)))
        | EQTYPE typdesc
          (A.SPECEQTYPE (typdesc, (EQTYPEleft, typdescright)))
        | DATATYPE datdesc
          (A.SPECDATATYPE (datdesc, (DATATYPEleft, datdescright)))
        | DATATYPE id_noSTAR EQ DATATYPE longtycon
          (A.SPECDATATYPEREP
             (id_noSTAR, longtycon, (DATATYPE1left, longtyconright)))
        | EXCEPTION exdesc
          (A.SPECEXCEPTION (exdesc, (EXCEPTIONleft, exdescright)))
        | STRUCTURE strdesc
          (A.SPECSTRUCTURE (strdesc, (STRUCTUREleft, strdescright)))
        | INCLUDE SIG spec END
          (A.SPECINCLUDE
             (A.SIGBASIC (Snoc.toList spec, (SIGleft, ENDright)),
              (INCLUDEleft, ENDright)))
        | INCLUDE alphabetic_id
          (A.SPECINCLUDE
             (A.SIGID alphabetic_id, (INCLUDEleft, alphabetic_idright)))
        | INCLUDE sigexpwhere
          (A.SPECINCLUDE
             (A.SIGWHERE
                (#1 sigexpwhere,
                 Snoc.toList (#2 sigexpwhere),
                 (sigexpwhereleft, sigexpwhereright)),
              (INCLUDEleft, sigexpwhereright)))
        | INCLUDE sigids
          (A.SPECINCLUDE_ID (sigids, (INCLUDEleft, sigidsright)))
        | SEMICOLON
          (A.SPECSEMICOLON (SEMICOLONleft, SEMICOLONright))

sigids
        : alphabetic_id alphabetic_id
          ([alphabetic_id1, alphabetic_id2])
        | alphabetic_id sigids
          (alphabetic_id :: sigids)

(*
  Ohori: valdesc now take poly_ty
  2007/11/11
*)
valdesc_1
        : id COLON poly_ty
          (id, poly_ty, (idleft, poly_tyright))
        | id COLON ty
          (id, ty, (idleft, tyright))

valdesc
        : valdesc_1
          ([valdesc_1])
        | valdesc_1 AND valdesc
          (valdesc_1 :: valdesc)

typdesc_1
        : tyvarseq id_noSTAR
          (tyvarseq, id_noSTAR, (tyvarseqleft, id_noSTARright))
        | id_noSTAR
          ((nil, Loc.noloc), id_noSTAR, (id_noSTARleft, id_noSTARright))

typdesc
        : typdesc_1
          ([typdesc_1])
        | typdesc_1 AND typdesc
          (typdesc_1 :: typdesc)

datdesc_1
        : id_noSTAR EQ condesc
          ((nil, Loc.noloc), id_noSTAR, condesc, (id_noSTARleft, condescright))
        | tyvarseq id_noSTAR EQ condesc
          (tyvarseq, id_noSTAR, condesc, (tyvarseqleft, condescright))

datdesc
        : datdesc_1
          ([datdesc_1])
        | datdesc_1 AND datdesc
          (datdesc_1 :: datdesc)

condesc_1
        : id
          (id, NONE, (idleft, idright))
        | id OF ty
          (id, SOME ty, (idleft, tyright))

condesc
        : condesc_1
          ([condesc_1])
        | condesc_1 BAR condesc
          (condesc_1 :: condesc)

exdesc
        : condesc_1
          ([condesc_1])
        | condesc_1 AND exdesc
          (condesc_1 :: exdesc)

strdesc
        : alphabetic_id COLON sigexp
          ([(alphabetic_id, sigexp, (alphabetic_idleft, sigexpright))])
        | alphabetic_id COLON sigexp_AND strdesc
          ((alphabetic_id, #1 sigexp_AND, (alphabetic_idleft, #2 sigexp_AND))
           :: strdesc)

funparam
        : alphabetic_id COLON sigexp
          (A.FUNPARAM (alphabetic_id, sigexp))
        | spec
          (A.FUNPARAM_SPEC (Snoc.toList spec))

funsig
        : COLON sigexp
          (SOME (A.TRANSPARENT, sigexp, (COLONleft, sigexpright)))
        | OPAQUE sigexp
          (SOME (A.OPAQUE, sigexp, (OPAQUEleft, sigexpright)))
        | (* none *)
          (NONE)

funbind_1
        : alphabetic_id LPAREN funparam RPAREN funsig EQ strexp
          (alphabetic_id, funparam, funsig, strexp,
           (alphabetic_idleft, strexpright))

funbind_1_AND
        : alphabetic_id LPAREN funparam RPAREN funsig EQ strexp_AND
          (alphabetic_id, funparam, funsig, #1 strexp_AND,
           (alphabetic_idleft, #2 strexp_AND))

funbind
        : funbind_1
          ([funbind_1])
        | funbind_1_AND funbind
          (funbind_1_AND :: funbind)

(*****************************top level declarations**************************)

topdecs
        : topdec
          ([topdec])
        | topdec topdecs
          (topdec :: topdecs)

topdec
        : strdec
          (A.TOPSTRDEC strdec)
        | SIGNATURE sigbind
          (A.TOPSIGNATURE (sigbind, (SIGNATUREleft, sigbindright)))
        | FUNCTOR funbind
          (A.TOPFUNCTOR (funbind, (FUNCTORleft, funbindright)))

topuse
        : USE STRING
          (A.USE ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
                  (USEleft, STRINGright)))
        | U_USE STRING
          (A.USE' ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
                   (U_USEleft, STRINGright)))

tops
        : topdecs
          ([A.TOPDEC (topdecs, (topdecsleft, topdecsright))])
        | topuse
          ([topuse])
        | topdecs topuse tops
          (A.TOPDEC (topdecs, (topdecsleft, topdecsright)) :: topuse :: tops)
        | topuse tops
          (topuse :: tops)

interface
        : U_INTERFACE STRING
          ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
           (U_INTERFACEleft, STRINGright))

compile_unit
        : interface
          (A.UNIT (SOME interface, nil, (interfaceleft, interfaceright)))
        | tops
          (A.UNIT (NONE, tops, (topsleft, topsright)))
        | interface tops
          (A.UNIT (SOME interface, tops, (interfaceleft, topsright)))
