(**
 * grammar for the interface langauge.
 * @copyright (C) 2021 SML# Development Team.
 * @author Atsushi Ohori
 * @author UENO Katsuhiro
 *)
structure A = Absyn
structure I = AbsynInterface

datatype 'a snoc = NIL | ::> of 'a snoc * 'a
fun append NIL l = l
  | append (::> (h, t)) l = append h (t :: l)
fun mapAppend f NIL l = l
  | mapAppend f (::> (h, t)) l = mapAppend f h (f t :: l)

%%

(*
  2011-12-12 Ohori
  Extended the interface language with
  (1) structure liplication,
      structure id = longid
   and
  (2) a restricted functor application
      structure id = functorid ( structureid)
  In doing this, I eliminated the AND construct in strexp.
  It is confusing and makes grammar and code unnecessarily complicated.
  (The same situation holds in other declarations.)

  2012-1-4 Ohori
  Extended the interface language with
  (3) variable alias declaration
      val id = longid  (VALALIAS_EXTERN below)
  This allows an interface to provide builtin primitives as in
    structure Array =
    struct
      ...
      val sub = SMLSharp.PrimArray.sub
      ...
   end
  where SMLSharp.PrimArray.sub is defined as the primitive Array_sub.
  By this addition, we can effectively inline primitives in the user code.
*)

%name InterfaceGrm
%header (structure InterfaceGrm)
%footer ()
%verbose

%pos A.pos

(* same token set as iml.grm *)
%term
    EOF
  | ABSTYPE
  | AND
  | ANDALSO
  | ARROW
  | AS
  | ASTERISK
  | AT
  | BAR
  | BUILTIN
  | CASE
  | CHAR of string
  | COLON
  | COMMA
  | DARROW
  | DATATYPE
  | END
  | EQ
  | EQTYPE
  | EQTYVAR of string
  | EXCEPTION
  | FN
  | FREE_EQTYVAR of string
  | FREE_TYVAR of string
  | FUN
  | FUNCTOR
  | HASH
  | SYMBOLICID of string
  | ALPHABETICID of string
  | IN
  | INCLUDE
  | INFIX
  | INFIXR
  | INT of {radix:StringCvt.radix, digits:string}
  | INTLAB of string
  | PREFIXEDLABEL of string
  | LBRACE
  | LBRACKET
  | LOCAL
  | LPAREN
  | NONFIX
  | OF
  | OP
  | OPAQUE
  | PERIOD
  | PERIODS
  | REQUIRE
  | RBRACE
  | RBRACKET
  | RPAREN
  | SEMICOLON
  | SHARING
  | SIG
  | SIGNATURE
  | SPECIAL of string
  | STRING of string
  | STRUCT
  | STRUCTURE
  | TYPE
  | TYVAR of string
  | UNDERBAR
  | USE'
  | VAL
  | WHERE
  | WITHTYPE

%nonterm
    (* the interface language *)
    ioverloadCase of I.overload_case
  | ioverloadMatch of I.overload_mrule list
  | ioverloadInst of I.overload_instance
  | ivalbind of I.valbind
  | iopaque_impl of I.opaque_impl
  | itypdesc_1 of I.typdesc
  | itypdesc of I.typdesc list
  | itypbind_1 of I.typbind
  | itypbind of I.typbind list
  | idec of I.dec
  | idecs of I.dec list
  | istrexp of I.strexp
  | istrbind of I.strbind
  | ifunbind of I.funbind
  | itopdec of I.topdec
  | itopdecs of I.topdec snoc
  | isigdec of I.sigdec
  | isigdecs of I.sigdec snoc
  | irequireopts of I.id list
  | irequire of I.require
  | irequires of I.require snoc
  | iinclude of I.include_dec
  | iincludes of I.include_dec snoc
  | isemicolons of I.loc snoc
  | itop of I.top
    (* copied from iml.grm *)
  | int of {radix : StringCvt.radix, digits : string}
  | alphabetic_id of A.id
  | id_noEQSTAR of A.id
  | id_noEQ of A.id
  | id_noSTAR of A.id
  | id of A.id
  | longid of A.longid
  | longstrid of A.longstrid
  | longtycon of A.longtycon
  | longtycon_noEQ of A.longtycon
  | vids of A.vid list
  | lab of A.lab
  | prec of string option
  | typbind_1 of A.typbind
  | typbind of A.typbind list
  | datbind_1 of A.datbind
  | datbind of A.datbind list
  | op_opt of bool
  | conbind_1 of A.conbind
  | conbind of A.conbind list
  | exbind_1 of A.exbind
  | exbind of A.exbind list
  | tyvar of A.tyvar
  | free_tyvar of A.tyvar
  | tyvarseq of A.tyvarseq
  | tyvars_comma of A.tyvar list
  | tyrow_1 of A.tyrow
  | tyrow of A.tyrow list
  | tyrow_flex of A.tyrow list * bool
  | atty of A.ty
  | appty of A.ty
  | tyseq of A.tyseq
  | tys_comma of A.ty list
  | tytuple of A.ty list
  | tuplety of A.ty
  | ty of A.ty
  | poly_tyrow_1 of A.tyrow
  | poly_tyrow of A.tyrow list
  | poly_ty1 of A.ty
  | poly_tytuple of A.ty list
  | poly_ty of A.ty
  | kind of A.id list * A.tyrow list option
  | kinded_tyvar of A.kinded_tyvar
  | kinded_free_tyvar of A.kinded_tyvar
  | kinded_tyvars of A.kinded_tyvar list
  | sigexpbasic of A.sigexp
  | wheretype of A.wheretype
  | sigexpwhere of A.sigexp * A.wheretype list
  | sigexp of A.sigexp
  | sigexp_AND of A.sigexp * A.pos
  | longtycons_eq of A.longtycon list
  | longstrids_eq of A.longstrid list
  | spec of A.spec list
  | atomicspec of A.spec
  | sigids of A.sigid list
  | valdesc_1 of A.valdesc
  | valdesc of A.valdesc list
  | typdesc_1 of A.typdesc
  | typdesc of A.typdesc list
  | datdesc_1 of A.datdesc
  | datdesc of A.datdesc list
  | condesc_1 of A.condesc
  | condesc of A.condesc list
  | exdesc of A.exdesc list
  | strdesc of A.strdesc list
  | sigbind of A.sigbind list
  | funparam of A.fun_param

%start itop
%eop EOF
%noshift EOF

%nonassoc DARROW
%nonassoc BAR

(* for error recovery *)
%keyword AND AS BUILTIN CASE DATATYPE END EQTYPE EXCEPTION FUNCTOR IN
         INFIX INFIXR NONFIX OF OP OPAQUE REQUIRE SHARING SIG SIGNATURE
        STRUCT STRUCTURE TYPE VAL WHERE
%value TYVAR ("")
%value SYMBOLICID ("")
%value ALPHABETICID ("")
%change -> VAL | -> LPAREN | -> END | -> SEMICOLON

%%

(******** The Interface Language ********)

ioverloadCase
        : CASE tyvar IN ty OF ioverloadMatch
          (tyvar, ty, ioverloadMatch, (CASEleft, ioverloadMatchright))

ioverloadMatch
        : ty DARROW ioverloadInst
          ([(ty, ioverloadInst, (tyleft, ioverloadInstright))])
        | ty DARROW ioverloadInst BAR ioverloadMatch
          ((ty, ioverloadInst, (tyleft, ioverloadInstright)) :: ioverloadMatch)

ioverloadInst
        : ioverloadCase
          (I.INST_OVERLOAD ioverloadCase)
        | longid
          (I.INST_LONGVID longid)
        | LPAREN ioverloadInst RPAREN
          (I.INST_PAREN (ioverloadInst, (LPARENleft, RPARENright)))

ivalbind
        : id COLON ty
          (I.VAL_EXTERN (id, ty, (idleft, tyright)))
        | id COLON poly_ty
          (I.VAL_EXTERN (id, poly_ty, (idleft, poly_tyright)))
        | id EQ longid
          (* 2012-1-4 ohori: variable alias in interface added *)
          (I.VAL_ALIAS (id, longid, (idleft, longidright)))
        | id EQ BUILTIN VAL id COLON ty
          (I.VAL_BUILTIN (id1, id2, ty, (id1left, tyright)))
        | id EQ BUILTIN VAL id COLON poly_ty
          (I.VAL_BUILTIN (id1, id2, poly_ty, (id1left, poly_tyright)))
        | id EQ ioverloadCase
          (I.VAL_OVERLOAD (id, ioverloadCase, (idleft, ioverloadCaseright)))

iopaque_impl
        : longtycon
          (I.IMPL_TY longtycon)
        | ASTERISK
          (I.IMPL_TUPLE (ASTERISKleft, ASTERISKright))
        | ARROW
          (I.IMPL_FUNC (ARROWleft, ARROWright))
        | LBRACE RBRACE
          (I.IMPL_RECORD (LBRACEleft, RBRACEright))

itypdesc_1
        : id_noSTAR LPAREN EQ iopaque_impl RPAREN
          ((nil, Loc.noloc), id_noSTAR, iopaque_impl,
           (id_noSTARleft, RPARENright))
        | tyvarseq id_noSTAR LPAREN EQ iopaque_impl RPAREN
          (tyvarseq, id_noSTAR, iopaque_impl, (tyvarseqleft, RPARENright))

itypdesc
        : itypdesc_1
          ([itypdesc_1])
        | itypdesc_1 AND itypdesc
          (itypdesc_1 :: itypdesc)

itypbind_1
        : typbind_1
          (I.TYPBIND typbind_1)
        | itypdesc_1
          (I.TYPDESC itypdesc_1)

itypbind
        : itypbind_1
          ([itypbind_1])
        | itypbind_1 AND itypbind
          (itypbind_1 :: itypbind)

idec
        : VAL ivalbind
          (I.VAL (ivalbind, (VALleft, ivalbindright)))
        | TYPE itypbind
          (I.TYPE (itypbind, (TYPEleft, itypbindright)))
        | EQTYPE itypdesc
          (I.EQTYPE (itypdesc, (EQTYPEleft, itypdescright)))
        | DATATYPE datbind
          (I.DATATYPE (datbind, nil, (DATATYPEleft, datbindright)))
        | DATATYPE datbind WITHTYPE typbind
          (I.DATATYPE (datbind, typbind, (DATATYPEleft, typbindright)))
        | DATATYPE id_noEQSTAR EQ DATATYPE longid
          (I.DATATYPEREP (id_noEQSTAR, longid, (DATATYPEleft, longidright)))
        | DATATYPE id_noEQSTAR EQ BUILTIN DATATYPE id_noSTAR
          (I.TYPEBUILTIN
             (id_noEQSTAR, id_noSTAR, (DATATYPEleft, id_noSTARright)))
        | EXCEPTION exbind
          (I.EXCEPTION (exbind, (EXCEPTIONleft, exbindright)))
        | STRUCTURE istrbind
          (I.STRUCTURE (istrbind, (STRUCTUREleft, istrbindright)))

idecs
        : (* none *)
          (nil)
        | idec idecs
          (idec :: idecs)
        | SEMICOLON idecs
          (I.SEMICOLON (SEMICOLONleft, SEMICOLONright) :: idecs)

istrexp
        : STRUCT idecs END
          (I.STRBASIC (idecs, (STRUCTleft, ENDright)))
        | longstrid
          (I.STRID longstrid)
        | alphabetic_id LPAREN longstrid RPAREN
          (I.STRAPP
             (alphabetic_id, longstrid, (alphabetic_idleft, RPARENright)))

istrbind
        : alphabetic_id EQ istrexp
          (alphabetic_id, istrexp, (alphabetic_idleft, istrexpright))

ifunbind
        : alphabetic_id LPAREN funparam RPAREN EQ istrexp
          (alphabetic_id, funparam, istrexp, (alphabetic_idleft, istrexpright))

itopdec
        : idec
          (I.DEC idec)
        | FUNCTOR ifunbind
          (I.FUNCTOR (ifunbind, (FUNCTORleft, ifunbindright)))
        | INFIX prec vids
          (I.INFIX (prec, vids, (INFIXleft, vidsright)))
        | INFIXR prec vids
          (I.INFIXR (prec, vids, (INFIXRleft, vidsright)))
        | NONFIX vids
          (I.NONFIX (vids, (NONFIXleft, vidsright)))

itopdecs
        : itopdec
          (::> (NIL, itopdec))
        | itopdecs itopdec
          (::> (itopdecs, itopdec))
        | itopdecs SEMICOLON
          (::> (itopdecs, I.DEC (I.SEMICOLON (SEMICOLONleft, SEMICOLONright))))

isigdec
        : SIGNATURE sigbind
          (I.SIGNATURE (sigbind, (SIGNATUREleft, sigbindright)))

isigdecs
        : isigdec
          (::> (NIL, isigdec))
        | isigdecs isigdec
          (::> (isigdecs, isigdec))
        | isigdecs SEMICOLON
          (::> (isigdecs, I.SIGSEMICOLON (SEMICOLONleft, SEMICOLONright)))

irequireopts
        : alphabetic_id
          ([alphabetic_id])
        | alphabetic_id irequireopts
          (alphabetic_id :: irequireopts)

irequire
        : REQUIRE STRING
          (I.REQUIRE
             ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
              nil,
              (REQUIREleft, STRINGright)))
        | REQUIRE STRING irequireopts
          (I.REQUIRE
             ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
              irequireopts,
              (REQUIREleft, irequireoptsright)))
        | REQUIRE LOCAL STRING
          (I.REQUIRE_LOCAL
             ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
              nil,
              (REQUIREleft, STRINGright)))
        | REQUIRE LOCAL STRING irequireopts
          (I.REQUIRE_LOCAL
             ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
              irequireopts,
              (REQUIREleft, irequireoptsright)))
        | USE' LOCAL STRING
          (I.USE_LOCAL
             ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
              (USE'left, STRINGright)))

irequires
        : irequire
          (::> (NIL, irequire))
        | irequires irequire
          (::> (irequires, irequire))
        | irequires SEMICOLON
          (::> (irequires, I.REQSEMICOLON (SEMICOLONleft, SEMICOLONright)))

iinclude
        : INCLUDE STRING
          (I.INCLUDE
             ((RequirePath.fromString STRING, (STRINGleft, STRINGright)),
              (INCLUDEleft, STRINGright)))

iincludes
        : iinclude
          (::> (NIL, iinclude))
        | iincludes iinclude
          (::> (iincludes, iinclude))
        | iincludes SEMICOLON
          (::> (iincludes, I.INCSEMICOLON (SEMICOLONleft, SEMICOLONright)))

isemicolons
        : (* none *)
          (NIL)
        | isemicolons SEMICOLON
          (::> (isemicolons, (SEMICOLONleft, SEMICOLONright)))

itop
        : isemicolons irequires itopdecs
          (I.INTERFACE
             (mapAppend I.REQSEMICOLON isemicolons (append irequires nil),
              append itopdecs nil,
              (isemicolonsleft, itopdecsright)))
        | isemicolons irequires
          (I.INTERFACE
             (mapAppend I.REQSEMICOLON isemicolons (append irequires nil),
              nil,
              (isemicolonsleft, irequiresright)))
        | isemicolons itopdecs
          (I.INTERFACE
             (mapAppend I.REQSEMICOLON isemicolons nil,
              append itopdecs nil,
              (isemicolonsleft, itopdecsright)))
        | isemicolons iincludes isigdecs
          (I.INCLUDES
             (mapAppend I.INCSEMICOLON isemicolons (append iincludes nil),
              append isigdecs nil,
              (isemicolonsleft, isigdecsright)))
        | isemicolons iincludes
          (I.INCLUDES
             (mapAppend I.INCSEMICOLON isemicolons (append iincludes nil),
              nil,
              (isemicolonsleft, iincludesright)))
        | isemicolons isigdecs
          (I.INCLUDES
             (mapAppend I.INCSEMICOLON isemicolons nil,
              append isigdecs nil,
              (isemicolonsleft, isigdecsright)))
        | isemicolons
          (I.INTERFACE
             (mapAppend I.REQSEMICOLON isemicolons nil,
              nil,
              (isemicolonsleft, isemicolonsright)))

(******** copied from iml.grm *********)

int
        : INT
          (INT)
        | INTLAB
          ({radix = StringCvt.DEC, digits = INTLAB})

alphabetic_id
        : ALPHABETICID
          (Symbol.fromString ALPHABETICID,
           (ALPHABETICIDleft, ALPHABETICIDright))
          (* difference: sql keywords *)

id_noEQSTAR
        : alphabetic_id
          (alphabetic_id)
        | SYMBOLICID
          (Symbol.fromString SYMBOLICID, (SYMBOLICIDleft, SYMBOLICIDright))

id_noEQ
        : id_noEQSTAR
          (id_noEQSTAR)
        | ASTERISK
          (Symbol.fromString "*", (ASTERISKleft, ASTERISKright))

id_noSTAR
        : id_noEQSTAR
          (id_noEQSTAR)
        | EQ
          (Symbol.fromString "=", (EQleft, EQright))

id
        : id_noEQ
          (id_noEQ)
        | EQ
          (Symbol.fromString "=", (EQleft, EQright))

longid
        : id
          ([id], (idleft, idright))
        | alphabetic_id PERIOD longid
          (alphabetic_id :: #1 longid, (alphabetic_idleft, longidright))

longstrid
        : alphabetic_id
          ([alphabetic_id], (alphabetic_idleft, alphabetic_idright))
        | alphabetic_id PERIOD longstrid
          (alphabetic_id :: #1 longstrid, (alphabetic_idleft, longstridright))

longtycon
        : id_noSTAR
          ([id_noSTAR], (id_noSTARleft, id_noSTARright))
        | alphabetic_id PERIOD longtycon
          (alphabetic_id :: #1 longtycon, (alphabetic_idleft, longtyconright))

longtycon_noEQ
        : id_noEQSTAR
          ([id_noEQSTAR], (id_noEQSTARleft, id_noEQSTARright))
        | alphabetic_id PERIOD longtycon
          (alphabetic_id :: #1 longtycon, (alphabetic_idleft, longtyconright))

vids
        : id
          ([id])
        | id vids
          (id :: vids)

lab
        : id
          (RecordLabel.fromSymbol (#1 id), (idleft, idright))
        | INTLAB
          (RecordLabel.fromString INTLAB, (INTLABleft, INTLABright))
        | STRING
          (RecordLabel.fromString STRING, (STRINGleft, STRINGright))
        | PREFIXEDLABEL
          (RecordLabel.fromString PREFIXEDLABEL,
           (PREFIXEDLABELleft, PREFIXEDLABELright))

prec
        : int
          (SOME (#digits int))
        | (* none *)
          (NONE)

typbind_1
        : id_noEQSTAR EQ ty
          ((nil, Loc.noloc), id_noEQSTAR, ty, (id_noEQSTARleft, tyright))
        | tyvarseq id_noEQSTAR EQ ty
          (tyvarseq, id_noEQSTAR, ty, (tyvarseqleft, tyright))

typbind
        : typbind_1
          ([typbind_1])
        | typbind_1 AND typbind
          (typbind_1 :: typbind)

datbind_1
        : id_noEQSTAR EQ conbind
          ((nil, Loc.noloc),
           id_noEQSTAR,
           conbind, (id_noEQSTARleft, conbindright))
        | tyvarseq id_noEQSTAR EQ conbind
          (tyvarseq, id_noEQSTAR, conbind, (tyvarseqleft, conbindright))

datbind
        : datbind_1
          ([datbind_1])
        | datbind_1 AND datbind
          (datbind_1 :: datbind)

op_opt
        : (* none *)
          (false)
        | OP
          (true)

conbind_1
        : op_opt id_noEQ
          ((op_opt, id_noEQ, (op_optleft, id_noEQright)),
           NONE,
           (op_optleft, id_noEQright))
        | op_opt id_noEQ OF ty
          ((op_opt, id_noEQ, (op_optleft, id_noEQright)),
           SOME ty,
           (op_optleft, tyright))

conbind
        : conbind_1
          ([conbind_1])
        | conbind_1 BAR conbind
          (conbind_1 :: conbind)

exbind_1
        : op_opt id_noEQ
          (A.EXBIND
             ((op_opt, id_noEQ, (op_optleft, id_noEQright)),
              NONE,
              (op_optleft, id_noEQright)))
        | op_opt id_noEQ OF ty
          (A.EXBIND
             ((op_opt, id_noEQ, (op_optleft, id_noEQright)),
              SOME ty,
              (op_optleft, tyright)))
        | op_opt id_noEQ EQ op_opt longid
          (A.EXBINDREP
             ((op_opt1, id_noEQ, (op_opt1left, id_noEQright)),
              (op_opt2, longid, (op_opt2left, longidright)),
              (op_opt1left, longidright)))

exbind
        : exbind_1
          ([exbind_1])
        | exbind_1 AND exbind
          (exbind_1 :: exbind)

tyvar
        : TYVAR
          (false, (Symbol.fromString TYVAR, (TYVARleft, TYVARright)))
        | EQTYVAR
          (true, (Symbol.fromString EQTYVAR, (EQTYVARleft, EQTYVARright)))

free_tyvar
        : FREE_TYVAR
          (false,
           (Symbol.fromString FREE_TYVAR, (FREE_TYVARleft, FREE_TYVARright)))
        | FREE_EQTYVAR
          (true,
           (Symbol.fromString FREE_EQTYVAR,
            (FREE_EQTYVARleft, FREE_EQTYVARright)))

tyvarseq
        : tyvar
          ([tyvar], (tyvarleft, tyvarright))
        | LPAREN tyvar RPAREN (* not in the definition *)
          ([tyvar], (LPARENleft, RPARENright))
        | LPAREN tyvars_comma RPAREN
          (tyvars_comma, (LPARENleft, RPARENright))

tyvars_comma
        : tyvar COMMA tyvar
          ([tyvar1, tyvar2])
        | tyvar COMMA tyvars_comma
          (tyvar :: tyvars_comma)

tyrow_1
        : lab COLON ty
          (lab, ty, (lableft, tyright))

tyrow
        : tyrow_1
          ([tyrow_1])
        | tyrow_1 COMMA tyrow
          (tyrow_1 :: tyrow)

tyrow_flex
        : tyrow_1
          ([tyrow_1], false)
        | tyrow_1 COMMA tyrow_flex
          (tyrow_1 :: #1 tyrow_flex, #2 tyrow_flex)
        | PERIODS (* not in the definition *)
          (nil, true)

atty
        : UNDERBAR
          (A.TYWILD (UNDERBARleft, UNDERBARright))
        | tyvar
          (A.TYVAR tyvar)
        | kinded_free_tyvar
          (A.TYVAR_FREE kinded_free_tyvar)
        | LBRACE tyrow_flex RBRACE
          (A.TYRECORD (#1 tyrow_flex, #2 tyrow_flex, (LBRACEleft, RBRACEright)))
        | LBRACE RBRACE
          (A.TYRECORD (nil, false, (LBRACEleft, RBRACEright)))
        | LPAREN ty RPAREN
          (A.TYPAREN (ty, (LPARENleft, RPARENright)))

appty
        : atty
          (atty)
        | tyseq longtycon_noEQ
          (A.TYCON (tyseq, longtycon_noEQ, (tyseqleft, longtycon_noEQright)))

tyseq
        : appty
          ([appty], (apptyleft, apptyright))
        | LPAREN tys_comma RPAREN
          (tys_comma, (LPARENleft, RPARENright))
        | (* none *)
          (nil, Loc.noloc)

tys_comma
        : ty COMMA ty
          ([ty1, ty2])
        | ty COMMA tys_comma
          (ty :: tys_comma)

tytuple
        : appty ASTERISK tytuple
          (appty :: tytuple)
        | appty ASTERISK appty
          ([appty1, appty2])

tuplety
        : appty
          (appty)
        | tytuple
          (A.TYTUPLE (tytuple, (tytupleleft, tytupleright)))

ty
        : tuplety
          (tuplety)
        | tuplety ARROW ty
          (A.TYFUN (tuplety, ty, (tupletyleft, tyright)))

poly_tyrow_1
        : lab COLON poly_ty
          (lab, poly_ty, (lableft, poly_tyright))

poly_tyrow
        : poly_tyrow_1
          ([poly_tyrow_1])
        | poly_tyrow_1 COMMA poly_tyrow
          (poly_tyrow_1 :: poly_tyrow)
        | poly_tyrow_1 COMMA tyrow
          (poly_tyrow_1 :: tyrow)
        | tyrow_1 COMMA poly_tyrow
          (tyrow_1 :: poly_tyrow)

poly_ty1
        : LBRACE poly_tyrow RBRACE
          (A.TYRECORD (poly_tyrow, false, (LBRACEleft, RBRACEright)))
        | LPAREN poly_ty RPAREN
          (A.TYPAREN (poly_ty, (LPARENleft, RPARENright)))
        | LBRACKET kinded_tyvars PERIOD ty RBRACKET
          (A.TYPOLY (kinded_tyvars, ty, (LBRACKETleft, RBRACKETright)))
        | LBRACKET kinded_tyvars PERIOD poly_ty RBRACKET
          (A.TYPOLY (kinded_tyvars, poly_ty, (LBRACKETleft, RBRACKETright)))

poly_tytuple
        : poly_ty1 ASTERISK poly_tytuple
          (poly_ty1 :: poly_tytuple)
        | poly_ty1 ASTERISK tytuple
          (poly_ty1 :: tytuple)
        | poly_ty1 ASTERISK poly_ty1
          ([poly_ty11, poly_ty12])
        | poly_ty1 ASTERISK appty
          ([poly_ty1, appty])
        | appty ASTERISK poly_tytuple
          (appty :: poly_tytuple)
        | appty ASTERISK poly_ty1
          ([appty, poly_ty1])

poly_ty
        : tuplety ARROW poly_ty
          (A.TYFUN (tuplety, poly_ty, (tupletyleft, poly_tyright)))
        | poly_tytuple
          (A.TYTUPLE (poly_tytuple, (poly_tytupleleft, poly_tytupleright)))
        | poly_ty1
          (poly_ty1)

kind
        : HASH LBRACE RBRACE
          (nil, SOME nil)
        | HASH LBRACE tyrow RBRACE
          (nil, SOME tyrow)
        | HASH alphabetic_id
          ([alphabetic_id], NONE)
        | HASH alphabetic_id kind
          ((alphabetic_id :: #1 kind), #2 kind)

kinded_tyvar
        : tyvar
          (tyvar, A.UNIV (nil, Loc.noloc), (tyvarleft, tyvarright))
        | tyvar kind
          (tyvar,
           case kind of
             (properties, NONE) =>
             A.UNIV (properties, (kindleft, kindright))
           | (properties, SOME tyrow) =>
             A.REC (properties, tyrow, (kindleft, kindright)),
           (tyvarleft, kindright))

kinded_free_tyvar
        : free_tyvar
          (free_tyvar,
           A.UNIV (nil, Loc.noloc),
           (free_tyvarleft, free_tyvarright))
        | free_tyvar kind
          (free_tyvar,
           case kind of
             (properties, NONE) =>
             A.UNIV (properties, (kindleft, kindright))
           | (properties, SOME tyrow) =>
             A.REC (properties, tyrow, (kindleft, kindright)),
           (free_tyvarleft, kindright))

kinded_tyvars
        : kinded_tyvar
          ([kinded_tyvar])
        | kinded_tyvar COMMA kinded_tyvars
          (kinded_tyvar :: kinded_tyvars)

sigexpbasic
        : SIG spec END
          (A.SIGBASIC (spec, (SIGleft, ENDright)))
        | alphabetic_id
          (A.SIGID alphabetic_id)

wheretype
        : longtycon EQ ty
          ((nil, Loc.noloc), longtycon, ty, (longtyconleft, tyright))
        | tyvarseq longtycon EQ ty
          (tyvarseq, longtycon, ty, (tyvarseqleft, tyright))

sigexpwhere
        : sigexp WHERE TYPE wheretype
          (sigexp, [wheretype])
        | sigexpwhere AND TYPE wheretype
          (#1 sigexpwhere, #2 sigexpwhere @ [wheretype])

sigexp
        : sigexpbasic
          (sigexpbasic)
        | sigexpwhere
          (A.SIGWHERE
             (#1 sigexpwhere,
              #2 sigexpwhere,
              (sigexpwhereleft, sigexpwhereright)))

sigexp_AND
        : sigexpbasic AND
          (sigexpbasic, sigexpbasicright)
        | sigexpwhere AND
          (A.SIGWHERE
             (#1 sigexpwhere,
              #2 sigexpwhere,
              (sigexpwhereleft, sigexpwhereright)),
           sigexpwhereright)

sigbind
        : alphabetic_id EQ sigexp
          ([(alphabetic_id, sigexp, (alphabetic_idleft, sigexpright))])
        | alphabetic_id EQ sigexp_AND sigbind
          ((alphabetic_id, #1 sigexp_AND, (alphabetic_idleft, #2 sigexp_AND))
           :: sigbind)

longtycons_eq
        : longtycon EQ longtycon
          ([longtycon1, longtycon2])
        | longtycon EQ longtycons_eq
          (longtycon :: longtycons_eq)

longstrids_eq
        : longstrid EQ longstrid
          ([longstrid1, longstrid2])
        | longstrid EQ longstrids_eq
          (longstrid :: longstrids_eq)

spec
        : (* none *)
          (nil)
        | spec atomicspec
          (spec @ [atomicspec])
        | spec SHARING TYPE longtycons_eq
          ([A.SPECSHARINGTYPE
              (spec, longtycons_eq, (specleft, longtycons_eqright))])
        | spec SHARING longstrids_eq
          ([A.SPECSHARING
              (spec, longstrids_eq, (specleft, longstrids_eqright))])

atomicspec
        : VAL valdesc
          (A.SPECVAL (valdesc, (VALleft, valdescright)))
        | TYPE typdesc
          (A.SPECTYPE (typdesc, (TYPEleft, typdescright)))
        | TYPE typbind
          (A.SPECTYPEINC (typbind, (TYPEleft, typbindright)))
        | EQTYPE typdesc
          (A.SPECEQTYPE (typdesc, (EQTYPEleft, typdescright)))
        | DATATYPE datdesc
          (A.SPECDATATYPE (datdesc, (DATATYPEleft, datdescright)))
        | DATATYPE id_noSTAR EQ DATATYPE longtycon
          (A.SPECDATATYPEREP
             (id_noSTAR, longtycon, (DATATYPE1left, longtyconright)))
        | EXCEPTION exdesc
          (A.SPECEXCEPTION (exdesc, (EXCEPTIONleft, exdescright)))
        | STRUCTURE strdesc
          (A.SPECSTRUCTURE (strdesc, (STRUCTUREleft, strdescright)))
        | INCLUDE SIG spec END
          (A.SPECINCLUDE
             (A.SIGBASIC (spec, (SIGleft, ENDright)),
              (INCLUDEleft, ENDright)))
        | INCLUDE alphabetic_id
          (A.SPECINCLUDE
             (A.SIGID alphabetic_id, (INCLUDEleft, alphabetic_idright)))
        | INCLUDE sigexpwhere
          (A.SPECINCLUDE
             (A.SIGWHERE
                (#1 sigexpwhere,
                 #2 sigexpwhere,
                 (sigexpwhereleft, sigexpwhereright)),
              (INCLUDEleft, sigexpwhereright)))
        | INCLUDE sigids
          (A.SPECINCLUDE_ID (sigids, (INCLUDEleft, sigidsright)))
        | SEMICOLON
          (A.SPECSEMICOLON (SEMICOLONleft, SEMICOLONright))

sigids
        : alphabetic_id alphabetic_id
          ([alphabetic_id1, alphabetic_id2])
        | alphabetic_id sigids
          (alphabetic_id :: sigids)

valdesc_1
        : id COLON poly_ty
          (id, poly_ty, (idleft, poly_tyright))
        | id COLON ty
          (id, ty, (idleft, tyright))

valdesc
        : valdesc_1
          ([valdesc_1])
        | valdesc_1 AND valdesc
          (valdesc_1 :: valdesc)

typdesc_1
        : tyvarseq id_noSTAR
          (tyvarseq, id_noSTAR, (tyvarseqleft, id_noSTARright))
        | id_noSTAR
          ((nil, Loc.noloc), id_noSTAR, (id_noSTARleft, id_noSTARright))

typdesc
        : typdesc_1
          ([typdesc_1])
        | typdesc_1 AND typdesc
          (typdesc_1 :: typdesc)

datdesc_1
        : id_noSTAR EQ condesc
          ((nil, Loc.noloc), id_noSTAR, condesc, (id_noSTARleft, condescright))
        | tyvarseq id_noSTAR EQ condesc
          (tyvarseq, id_noSTAR, condesc, (tyvarseqleft, condescright))

datdesc
        : datdesc_1
          ([datdesc_1])
        | datdesc_1 AND datdesc
          (datdesc_1 :: datdesc)

condesc_1
        : id
          (id, NONE, (idleft, idright))
        | id OF ty
          (id, SOME ty, (idleft, tyright))

condesc
        : condesc_1
          ([condesc_1])
        | condesc_1 BAR condesc
          (condesc_1 :: condesc)

exdesc
        : condesc_1
          ([condesc_1])
        | condesc_1 AND exdesc
          (condesc_1 :: exdesc)

strdesc
        : alphabetic_id COLON sigexp
          ([(alphabetic_id, sigexp, (alphabetic_idleft, sigexpright))])
        | alphabetic_id COLON sigexp_AND strdesc
          ((alphabetic_id, #1 sigexp_AND, (alphabetic_idleft, #2 sigexp_AND))
           :: strdesc)

funparam
        : alphabetic_id COLON sigexp
          (A.FUNPARAM (alphabetic_id, sigexp))
        | spec
          (A.FUNPARAM_SPEC spec)
