(**
 * @copyright (C) 2021 SML# Development Team.
 * @author YAMATODANI Kiyoshi
 * @author Katsuhiro Ueno
 *)
structure ElaborateError =
struct

  (***************************************************************************)

  (*%
   * @formatter(AbsynTy.tyvar) AbsynTyFormatter.format_tyvar
   * @formatter(Symbol.symbol) Symbol.format_symbol
   *)
  exception

  (**
   * <pre>
   *  type t = (int, int) option
   * </pre>
   *)
  (*%
   * @format({tycon, wants, given})
   * "type" +d "constructor" +d tycon +d "given" +d given +d "arguments,"
   * +d "wants" +d wants
   *)
  ArityMismatchInTypeDeclaration of
  {tycon : Symbol.symbol, wants : int, given : int}

  and
  (*%
   * @format(id)
   * "expression" +d "or" +d "pattern" +d "begins" +d "with" +d "infix"
   * +d "identifier" +d ":" +d id
   *)
  BeginWithInfixID of Symbol.symbol

  and
  (**
   * <pre>
   *    type ('a,'a) foo = ty
   * </pre>
   *)
  (*%
   * @format(name)
   * "Duplicate" +d  "type" +d "parameter:" + name
   *)
  DuplicateTypeParam of Symbol.symbol

  and
  (*%
   * @format(id)
   * "expression" +d "or" +d "pattern" +d "ends" +d "with" +d "infix"
   * +d "identifier" +d ":" +d id
   *)
  EndWithInfixID of Symbol.symbol

  and
  (*%
   * @format
   * "can't" +d "find" +d "function" +d "arguments" +d "in" +d "clause"
   *)
  FunctionParameterNotFound

  and
  (*%
   * @format
   * "illegal" +d "function" +d "symbol" +d "in" +d "clause"
   *)
  IllegalFunctionSymbol

  and
  (*%
   * @format
   * "improper" +d "infix" +d "pattern" +d "in" +d "function" +d "clause"
   *)
  ImproperInfixPattern

  and
  (*%
   * @format
   * "clauses" +d "don't" +d "all" +d "have" +d "same" +d "function" +d "name"
   *)
  NotAllHaveSameFunctionName

  and
  (*%
   * @format
   * "clauses" +d "don't" +d "all" +d "have" +d "same" +d "number"
   * +d "of" +d "patterns"
   *)
  NotAllHaveSameNumberPatterns

  and
  (**
   * <pre>
   * datatype t = D of 'a
   * val x = y : 'a   (top level)
   * </pre>
   *)
  (*%
   * @format(tyvar)
   * "free" +d "type" +d "variable:" +d tyvar
   *)
  NotBoundTyvar of Symbol.symbol

  and
  (*%
   * @format
   * "bound" +d "expression" +d "in" +d "val" +d "rec" +d "must" +d "be" +d "fn"
   *)
  NotFnBoundInValRec

  and
  (*
   *)
  (*%
   * @format
   * "no" +d "real" +d "constant" +d "may" +d "occur" +d "in" +d "a" +d
   * "pattern"
   *)
  RealConstantInPattern

  and
  (*
   *)
  (*%
   * @format(attr)
   * "undefined" +d "foreign" +d "attribute:" +d attr
   *)
  UndefinedFFIAttribute of string

  and
  (*%
   * @format(tvar)
   * "duplicate" +d "user" +d "type" +d "variable" +d "in" +d "declaration:"
   * +d tvar
   *)
  DuplicateUserTvar of AbsynTy.tyvar

  and
  (*%
   * @format(tvar)
   * "user" +d "type" +d "variable" +d tvar +d "is" +d "scoped" +d "at"
   * +d "outer" +d "declaration"
   *)
  UserTvarScopedAtOuterDecl of AbsynTy.tyvar

  and
  (*%
   * @format
   * "fixity" +d "precedence" +d "must" +d "be" +d "between" +d "0" +d "and"
   * +d "9"
   *)
  InvalidFixityPrecedence

  and
  (*%
   * @format(vid)
   * "multiple" +d "infix" +d "declaration:" +d "in" +d "interface:" +d vid
   *)
  MultipleInfixInInterface of Symbol.symbol

  and
  (*%
   * @format
   * "derived" +d "form" +d "for" +d "functor" +d "argument" +d "is" +d
   * "not" +d "supported" +d "in" +d "interface" +d "file"
   *)
  DerivedFormFunArg

  and
  (*%
   * @format(id1 * id2)
   * "operators" +d "of" +d "same" +d "precedence" +d "with" +d "mixed" +d
   * "associativities:" +d id1 +d "and" +d id2
   *)
  InvalidOpAssociativity of Symbol.symbol * Symbol.symbol

  and
  (*%
   * @format(id)
   * "provide" +d "check" +d "fails" +d "(missing infix):" +d id
   *)
  ProvideInfixNotDefined of Symbol.symbol

  and
  (*%
   * @format(id)
   * "provide" +d "check" +d "fails" +d "(infix mismatch):" +d id
   *)
  ProvideInfixMismatch of Symbol.symbol

  and
  (*%
   * @format
   * "identifier" +d "expected" +d "in" +d "constructor" +d "pattern"
   *)
  PatappWithoutIdentifier

  and
  (*%
   * @format(tvar)
   * "user" +d "type" +d "variable" +d "implicitly" +d "scoped" +d "at"
   * +d "val" +d "_polyrec:" +d tvar
   *)
  UserTyvarImplicitlyBoundAtPolyRec of AbsynTy.tyvar

  and
  (*%
   * @format
   * "polymorphic" +d "type" +d "is" +d "not" +d "allowed" +d "here"
   *)
  PolyTyNotAllowed

  and
  (*%
   * @format
   * "flex" +d "record" +d "type" +d "is" +d "not" +d "allowed" +d "here"
   *)
  FlexRecordTyNotAllowed

  and
  (*%
   * @format
   * "wildcard" +d "type" +d "annotation" +d "is" +d "not" +d "allowed"
   * +d "here"
   *)
  WildTyNotAllowed

  and
  (*%
   * @format
   * "free" +d "tyvar" +d "annotation" +d "is" +d "not" +d "allowed" +d "here"
   *)
  FreeTyNotAllowed

end
