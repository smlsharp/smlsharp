_require local "../../../../basis.smi"
_require local "../../../libs/util/main/CompileUtils.smi"
_require "../../../data/symbols/main/Symbol.smi"
_require local "../../../data/symbols/main/Loc.smi"
_require local "../../../extensions/usererror/main/UserErrorUtils.smi"
_require "../../../compilerIRs/absyn/main/Absyn.smi"
_require local "../../../compilerIRs/absyn/main/AbsynUtils.smi"
_require local "./ElaborateError.ppg.smi"
_require "../../../compilerIRs/patterncalc/main/PatternCalc.ppg.smi"

structure ElaborateTy =
struct
  type ftv = (Absyn.tyvar * Absyn.tyvar list) Symbol.Map.map
  val singleton : Absyn.tyvar -> ftv
  val union : ftv * ftv -> ftv
  val unionList : ftv list -> ftv
  val intersect : 'a Symbol.Map.map * ftv -> 'a Symbol.Map.map
  val setMinus : 'a Symbol.Map.map * ftv -> 'a Symbol.Map.map
  val tyvarseqToSet : Absyn.tyvarseq option -> ftv
  val kindedTyvarseqToSet : Absyn.kinded_tyvarseq option -> ftv
  val toKindedTyvars : ftv -> Absyn.kinded_tyvar list
  val ftvKindedTyvarseq : Absyn.kinded_tyvarseq option -> ftv
  val ftvTy : Absyn.ty -> ftv
  val ftvTypbind : Absyn.typbind -> ftv
  val ftvDatbind : Absyn.datbind -> ftv
  val ftvDatdesc : Absyn.datdesc -> ftv
  val ftvWheretype : Absyn.wheretype -> ftv
  val substTy : (Absyn.loc -> Absyn.ty) Symbol.Map.map -> Absyn.ty -> Absyn.ty
  val reduceTy : Absyn.typbind Symbol.Map.map -> Absyn.ty -> Absyn.ty
  val reduceDatbind
      : Absyn.datbind list * Absyn.withty option -> Absyn.datbind list
  val appendTyvarseq
      : Absyn.kinded_tyvarseq option * Absyn.kinded_tyvar list
        -> Absyn.kinded_tyvarseq option
  val elabMonoTy : Absyn.ty -> PatternCalc.ty
  val elabRank1Ty : Absyn.ty -> PatternCalc.ty
end
