structure Elaborator =
struct
  type fix_env = (Fixity.fixity * Absyn.loc) Symbol.Map.map
  val extendFixEnv : fix_env * fix_env -> fix_env
  val elaborate :
      fix_env
      -> AbsynInterfaceLoaded.compile_unit
      -> fix_env * PatternCalcInterface.compile_unit * UserError.errorInfo list
  val elaborateInterface :
      AbsynInterfaceLoaded.interface_unit
      -> fix_env
         * PatternCalcInterface.interface_unit
         * UserError.errorInfo list
end
