structure ElaborateError =
  struct
    exception InvalidOpAssociativity of Symbol.symbol * Symbol.symbol
    exception DerivedFormFunArg
    exception MultipleInfixInInterface of Symbol.symbol
    exception InvalidFixityPrecedence
    exception UserTvarScopedAtOuterDecl of AbsynTy.tyvar
    exception DuplicateUserTvar of AbsynTy.tyvar
    exception UndefinedFFIAttribute of string
    exception RealConstantInPattern
    exception NotFnBoundInValRec
    exception NotBoundTyvar of Symbol.symbol
    exception NotAllHaveSameNumberPatterns
    exception NotAllHaveSameFunctionName
    exception ImproperInfixPattern
    exception IllegalFunctionSymbol
    exception FunctionParameterNotFound
    exception EndWithInfixID of Symbol.symbol
    exception DuplicateTypeParam of Symbol.symbol
    exception BeginWithInfixID of Symbol.symbol
    exception ProvideInfixNotDefined of Symbol.symbol
    exception ProvideInfixMismatch of Symbol.symbol
    exception ArityMismatchInTypeDeclaration of
              {given : int, tycon : Symbol.symbol, wants : int}
    exception PatappWithoutIdentifier
  end
