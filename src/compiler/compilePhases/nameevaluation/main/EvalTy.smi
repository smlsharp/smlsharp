structure EvalTy =
struct
  type tvarEnv = IDCalc.tvar Symbol.Map.map
  val emptyTvarEnv : tvarEnv
  val genTvarList : tvarEnv -> PatternCalc.tyvar list -> tvarEnv * IDCalc.tvar list
  val evalTy : tvarEnv -> NameEvalEnv.env -> PatternCalc.mono_ty -> IDCalc.ty
  val evalPolyTy : tvarEnv -> NameEvalEnv.env -> PatternCalc.poly_ty -> IDCalc.ty
  val evalTyWithFlex : tvarEnv -> NameEvalEnv.env -> PatternCalc.annot_ty -> IDCalc.ty
  val getProperty : tvarEnv -> NameEvalEnv.env -> PatternCalcInterface.opaque_impl -> Loc.loc -> IDCalc.property
  val compatProperty : {abs:IDCalc.property, impl:IDCalc.property} -> bool
  val evalTvar : tvarEnv -> PatternCalc.tyvar -> IDCalc.tvar
  val evalFfity : tvarEnv -> NameEvalEnv.env -> PatternCalc.ffi_ty -> IDCalc.ffiTy
  val emptyScopedTvars : IDCalc.scopedTvars
  val evalScopedTvars : 
      tvarEnv 
      -> NameEvalEnv.env
      -> PatternCalc.kinded_tyvarseq
      -> tvarEnv * IDCalc.kindedTvar list
  val evalDatatype :
      NameEvalEnv.env
                        -> PatternCalc.datbind list
                           * PatternCalc.typbind list
                           * Loc.loc
                        -> NameEvalEnv.env * IDCalc.icdecl list
  val resetFreeTvarEnv : unit -> unit

  val reservedNameSet : Symbol.Set.set
  val reservedConNameSet : Symbol.Set.set
  val checkReservedName
      : Symbol.Set.set -> ('a -> SymbolWithLoc.symbol) -> 'a list -> unit
end
