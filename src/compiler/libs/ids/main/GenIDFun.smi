_require "../../../../basis.smi"
_require "../../../../smlformat-lib.smi"
_require "../../../libs/env/main/IEnv.smi"
_require "../../../libs/env/main/ISet.smi"

structure GenID =
struct
  type id = int
  structure Map = IEnv
  structure Set = ISet
  val compare : id * id -> order
  val eq : id * id -> bool
  val generate : unit -> id
  val format_id : id -> SMLFormat.FormatExpression.expression list
  val toString : id -> string
  val toInt : id -> int
  val setReservedId : unit -> unit
  val isReserved : id -> bool
end
